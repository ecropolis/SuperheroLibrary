---
/**
 * Demo for `parallax-band`. The website renders this too (see README, "Consumed by
 * superherotech.ai"), so assets go through `asset()` and every host token has a fallback.
 */
import ParallaxBand from '../../library/parallax-band/ParallaxBand.astro';
interface Props {
  /** Where public/demo/ is served. The gallery uses /demo/; the website passes /elements-demo/. */
  assetBase?: string;
}
const { assetBase = '/demo/' } = Astro.props;
const asset = (name: string) => assetBase + name;
---
<div class="demo-pb">
  <ParallaxBand image={asset('hills.svg')} width={1600} height={1000} speed={0.5} overlay={0.15} minHeight="20rem">
    <p class="demo-pb__copy">Copy scrolls with the page.<br /><span>The hills behind it move at half the speed.</span></p>
  </ParallaxBand>
</div>
<style>
  .demo-pb {
    --pb-bg: var(--navy, #1e283c);
    --pb-overlay: var(--navy, #1e283c);
    --pb-fg: var(--white, #fff);
    border-radius: var(--radius, 14px);
    overflow: hidden;
  }
  .demo-pb__copy {
    margin: 0;
    text-align: center;
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .demo-pb__copy span {
    font-weight: 400;
    font-size: 1rem;
    opacity: 0.85;
  }
</style>
