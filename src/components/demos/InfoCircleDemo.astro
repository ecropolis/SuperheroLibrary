---
/**
 * Demo for `info-circle`. The website renders this too (see README, "Consumed by
 * superherotech.ai"), so assets go through `asset()` and every host token has a fallback.
 *
 * Two circles, as on the reference: five icons for a process, turning on its own every 5 s
 * (with its pause button), and four round images with a link under each text, starting on the
 * second. The items live in public/demo/info-circle-items.json, which
 * scripts/check-reveal-cards.mjs reads to pin the built page against. In a column narrower
 * than 28rem (a phone) both are plain lists, as they are without JavaScript.
 *
 * The icons are Font Awesome Free (CC BY 4.0), pasted with their attribution comment exactly as
 * the package ships them; the check compares each path with the installed package.
 */
import InfoCircle from '../../library/info-circle/InfoCircle.astro';
import fixture from '../../../public/demo/info-circle-items.json';

interface Props {
  /** Where public/demo/ is served. The gallery uses /demo/; the website passes /elements-demo/. */
  assetBase?: string;
}
const { assetBase = '/demo/' } = Astro.props;
const asset = (name: string) => assetBase + name;

