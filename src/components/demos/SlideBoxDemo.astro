---
/**
 * Demo for `slide-box`. The website renders this too (see README, "Consumed by
 * superherotech.ai"), so assets go through `asset()` and every host token has a fallback.
 *
 * Four cards, one per `direction`: the back rises from the bottom (up, the default), comes in
 * from the right (left), drops from the top (down, on an image card) and comes in from the left
 * (right, on a card that ignores hover). The cards live in public/demo/slide-box-cards.json,
 * which scripts/check-reveal-cards.mjs reads to pin the built page against.
 *
 * The icons are Font Awesome Free (CC BY 4.0), pasted with their attribution comment exactly as
 * the package ships them; the check compares each path with the installed package.
 */
import SlideBox from '../../library/slide-box/SlideBox.astro';
import fixture from '../../../public/demo/slide-box-cards.json';

interface Props {
  /** Where public/demo/ is served. The gallery uses /demo/; the website passes /elements-demo/. */
  assetBase?: string;
}
const { assetBase = '/demo/' } = Astro.props;
const asset = (name: string) => assetBase + name;

// Font Awesome Free 7, solid style.
