---
/**
 * Demo for `sticker`. The website renders this too (see README, "Consumed by
 * superherotech.ai"), so assets go through `asset()` and every host token has a fallback.
 *
 * Four product cards, one sticker each: a "Sale" ribbon, a "-20%" circle (read "20% off"
 * without a label, by the element's own rule), a "New" label, and a "2 for 1" circle with an
 * explicit label. Each sticker sits inside the card's image box, which is position: relative;
 * that is the host's job, and the demo does it the way a host should.
 */
import Sticker from '../../library/sticker/Sticker.astro';
interface Props {
  /** Where public/demo/ is served. The gallery uses /demo/; the website passes /elements-demo/. */
  assetBase?: string;
}
const { assetBase = '/demo/' } = Astro.props;
const asset = (name: string) => assetBase + name;
---
<div class="demo-sk" id="sticker-demo">
  <article class="demo-sk__card">
    <div class="demo-sk__media">
      <Sticker shape="ribbon" corner="top-right" tone="sale" text="Sale" />
      <img src={asset('hills.svg')} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
    </div>
    <h3><a href="#sticker-demo">Evening print</a></h3>
    <p>$45, was $60</p>
  </article>
  <article class="demo-sk__card">
    <div class="demo-sk__media">
      <Sticker shape="circle" tone="sale" text="-20%" />
      <img src={asset('promo.svg')} alt="" width="480" height="270" loading="lazy" decoding="async" />
    </div>
    <h3><a href="#sticker-demo">Dashboard poster</a></h3>
    <p>$32, was $40</p>
  </article>
  <article class="demo-sk__card">
    <div class="demo-sk__media">
      <Sticker shape="label" corner="bottom-left" text="New" />
      <img src={asset('hills.svg')} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
    </div>
    <h3><a href="#sticker-demo">Hillside card set</a></h3>
    <p>$18</p>
  </article>
  <article class="demo-sk__card">
    <div class="demo-sk__media">
      <Sticker shape="circle" corner="bottom-right" tone="dark" text="2 for 1" label="Buy one, get one free" />
      <img src={asset('promo.svg')} alt="" width="480" height="270" loading="lazy" decoding="async" />
    </div>
    <h3><a href="#sticker-demo">Report notebook</a></h3>
    <p>$12</p>
  </article>
</div>
<style>
  .demo-sk {
    --sk-accent-bg: var(--purple, #5933d8);
    --sk-dark-bg: var(--navy, #1e283c);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 1rem;
  }
  .demo-sk__card {
    overflow: hidden;
    border: 1px solid var(--line, #d5d9e2);
    border-radius: var(--radius, 12px);
    background: var(--white, #fff);
    color: var(--ink, #1d2433);
  }
  /* The host's half of the contract: the box the sticker marks is positioned. */
  .demo-sk__media {
    position: relative;
  }
  .demo-sk__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .demo-sk__card h3 {
    margin: 0.75rem 1rem 0.25rem;
    font-size: 1rem;
  }
  .demo-sk__card h3 a {
    color: inherit;
  }
  .demo-sk__card h3 a:focus-visible {
    outline: 3px solid var(--purple, #5933d8);
    outline-offset: 2px;
  }
  .demo-sk__card p {
    margin: 0 1rem 1rem;
    font-size: 0.9rem;
  }
</style>
