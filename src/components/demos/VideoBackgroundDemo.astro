---
/**
 * Demo for `video-background`. The website renders this too (see README, "Consumed by
 * superherotech.ai"), so assets go through `asset()` and every host token has a fallback.
 */
import VideoBackground from '../../library/video-background/VideoBackground.astro';
interface Props {
  /** Where public/demo/ is served. The gallery uses /demo/; the website passes /elements-demo/. */
  assetBase?: string;
}
const { assetBase = '/demo/' } = Astro.props;
const asset = (name: string) => assetBase + name;
---
<div class="demo-vb">
  <VideoBackground
    src={[
      { src: asset('drift.webm'), type: 'video/webm' },
      { src: asset('drift.mp4'), type: 'video/mp4' },
    ]}
    poster={asset('drift-poster.jpg')}
    overlay={0.25}
    minWidth={0}
  >
    <p class="demo-vb__copy">Copy sits above the video.<br /><span>The button bottom right pauses it.</span></p>
  </VideoBackground>
</div>
<style>
  .demo-vb {
    --vb-min-height: 20rem;
    --vb-bg: var(--navy, #1e283c);
    --vb-overlay: var(--navy, #1e283c);
    --vb-fg: var(--white, #fff);
    --vb-focus: var(--white, #fff);
    border-radius: var(--radius, 14px);
    overflow: hidden;
  }
  .demo-vb__copy {
    margin: 0;
    text-align: center;
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .demo-vb__copy span {
    font-weight: 400;
    font-size: 1rem;
    opacity: 0.85;
  }
</style>
