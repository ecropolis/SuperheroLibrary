---
/**
 * Demo for `card-slider`. The website renders this too (see README, "Consumed by
 * superherotech.ai"), so assets go through `asset()` and every host token has a fallback.
 *
 * Two instances: testimonials (1 / 2 / 3 per page, no autoplay, no loop) and posts with
 * images and links (1 / 2 per page, autoplay with its pause button, loop).
 */
import CardSlider from '../../library/card-slider/CardSlider.astro';
interface Props {
  /** Where public/demo/ is served. The gallery uses /demo/; the website passes /elements-demo/. */
  assetBase?: string;
}
const { assetBase = '/demo/' } = Astro.props;
const asset = (name: string) => assetBase + name;

const quotes = [
  { q: 'They fitted the whole kitchen in four days and left it cleaner than they found it.', who: 'Dana R.', where: 'Riverside' },
  { q: 'The quote was the price. No surprises at the end, which is a first for us.', who: 'Marcus T.', where: 'Old Town' },
  { q: 'Our bathroom finally has a shower that drains. Friendly, tidy and on time.', who: 'Priya S.', where: 'Hillcrest' },
  { q: 'They answered the phone on a Saturday when a pipe burst. That is why we call them first.', who: 'Tom and Ellen K.', where: 'Northgate' },
  { q: 'Good advice about what not to spend money on. We saved more than their fee.', who: 'Luis M.', where: 'Eastfield' },
  { q: 'Photos every evening of what had been done that day, so we never had to chase.', who: 'Hannah W.', where: 'Lakeview' },
  { q: 'Second project with them and it will not be the last.', who: 'Sam O.', where: 'Millbrook' },
];
const posts = [
  { title: 'How to plan a kitchen you will still like in ten years', img: 'hills.svg' },
  { title: 'Five questions to ask before you sign a quote', img: 'promo.svg' },
  { title: 'What a bathroom remodel costs, line by line', img: 'hills.svg' },
  { title: 'Tiles, grout and the ten-minute test for a good fitter', img: 'promo.svg' },
  { title: 'Permits: when you need one and who applies', img: 'hills.svg' },
];
---
<div class="demo-cs">
  <section>
    <h2 class="demo-cs__h">What our customers say</h2>
    <CardSlider label="What our customers say" class="demo-cs__quotes">
      {
        quotes.map((t) => (
          <figure class="demo-cs__quote">
            <blockquote>
              <p>“{t.q}”</p>
            </blockquote>
            <figcaption>
              <strong>{t.who}</strong>, {t.where}
            </figcaption>
          </figure>
        ))
      }
    </CardSlider>
  </section>

  <section>
    <h2 class="demo-cs__h">From the blog</h2>
    <CardSlider label="From the blog" perView={{ base: 1, md: 2 }} autoplay interval={4000} loop class="demo-cs__posts">
      {
        posts.map((p, i) => (
          <article class="demo-cs__post">
            <img src={asset(p.img)} alt="" width="480" height="270" loading="lazy" />
            <h3>
              <a href={`#post-${i + 1}`}>{p.title}</a>
            </h3>
          </article>
        ))
      }
    </CardSlider>
  </section>
</div>
<style>
  .demo-cs {
    display: grid;
    gap: 2.5rem;
    color: var(--ink, #16192a);
  }
  .demo-cs__h {
    margin: 0 0 1rem;
    font-size: 1.35rem;
  }
  .demo-cs :global(.demo-cs__quotes),
  .demo-cs :global(.demo-cs__posts) {
    --cs-control-bg: var(--purple, #5933d8);
    --cs-control-fg: var(--white, #fff);
    --cs-dot-active: var(--purple, #5933d8);
    --cs-focus: var(--purple, #5933d8);
  }
  .demo-cs__quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--line, #e6e6f0);
    border-radius: var(--radius, 14px);
    background: var(--tint, #f8f8fc);
  }
  .demo-cs__quote blockquote {
    margin: 0;
  }
  .demo-cs__quote p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
  }
  .demo-cs__quote figcaption {
    font-size: 0.95rem;
  }
  .demo-cs__post {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line, #e6e6f0);
    border-radius: var(--radius, 14px);
    background: var(--white, #fff);
  }
  .demo-cs__post img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .demo-cs__post h3 {
    margin: 0;
    padding: 1rem 1.25rem 1.25rem;
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .demo-cs__post a {
    color: inherit;
  }
</style>
