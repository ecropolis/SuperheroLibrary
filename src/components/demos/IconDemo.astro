---
/**
 * Demo for `icon`. The website renders this too (see README, "Consumed by
 * superherotech.ai"), and it is where the searchable UI lives so both places get it (this
 * repo's own /icons/ gallery page just imports this component).
 *
 * public/demo/icon-data.json (generated by `npm run build:icon-data`, see that script's
 * header) is every Font Awesome Free icon: name, display label, search terms and, per style
 * it ships in, its viewBox and path data. This component imports it at build time (a Node-only
 * cost — Astro frontmatter never reaches the browser) to render the first 200 icons as real,
 * inline-SVG `<Icon>` tiles, so the page has a working grid before any JavaScript runs.
 *
 * Page-weight budget: rendering all 2,606 icons' path data inline measured at ~1.8 MB of HTML
 * for the path data alone — over the ~1 MB the README budgets for the gallery. So this demo
 * renders the first 200 as real tiles (usable, copyable, no JS needed) and fetches the same
 * icon-data.json on demand — only once the visitor searches, changes the style filter, or
 * asks for more — to search and page through the rest client-side. That means, without
 * JavaScript, search is absent (as expected) AND the grid stops at the first 200 of 2,606:
 * a deliberate trade against the page-weight budget, not an oversight.
 */
import Icon from '../../library/icon/Icon.astro';
import iconData from '../../../public/demo/icon-data.json';

interface Props {
  /** Where public/demo/ is served. The gallery uses /demo/; the website passes /elements-demo/. */
  assetBase?: string;
}
const { assetBase = '/demo/' } = Astro.props;
const asset = (name: string) => assetBase + name;

type Entry = { n: string; l: string; t: string[]; s: Record<string, [string, string]> };
const data = iconData as unknown as Entry[];

const PAGE_SIZE = 200;
const total = data.length;
const first = data.slice(0, PAGE_SIZE);

const preferredStyle = (e: Entry) => (e.s.solid ? 'solid' : e.s.regular ? 'regular' : 'brands');
---

<div class="icon-gallery" data-icon-gallery data-icon-src={asset('icon-data.json')} data-icon-total={total}>
  <ul class="icon-patterns" aria-label="Usage patterns">
    <li class="icon-pattern">
      <button type="button" class="icon-pattern__btn" disabled title="Illustrative only">
        <Icon name="trash-can" style="regular" label="Delete" size="1.25em" />
      </button>
      <p>
        Icon-only button: <code>label</code> names it. This button's whole accessible name is "Delete", even
        though there is no visible text.
      </p>
    </li>
    <li class="icon-pattern">
      <span class="icon-pattern__btn" aria-hidden="true">
        <Icon name="circle-info" title="Shown on hover, in supporting browsers" size="1.25em" />
      </span>
      <p>Decorative next to its own text (no <code>label</code>), but with a native <code>title</code> tooltip.</p>
    </li>
  </ul>

  <div class="icon-controls">
    <div class="icon-search">
      <label>
        <span>Search icons</span>
        <input type="search" placeholder="e.g. arrow, shopping, calendar" data-icon-search />
      </label>
    </div>
    <fieldset class="icon-styles">
      <legend>Style</legend>
      <label class="icon-chip">
        <input type="radio" name="icon-style" value="all" checked data-icon-style />
        <span>All</span>
      </label>
      <label class="icon-chip">
        <input type="radio" name="icon-style" value="solid" data-icon-style />
        <span>Solid</span>
      </label>
      <label class="icon-chip">
        <input type="radio" name="icon-style" value="regular" data-icon-style />
        <span>Regular</span>
      </label>
      <label class="icon-chip">
        <input type="radio" name="icon-style" value="brands" data-icon-style />
        <span>Brands</span>
      </label>
    </fieldset>
  </div>

  <p class="icon-status" data-icon-status>{`Showing ${first.length} of ${total.toLocaleString()} icons.`}</p>
  <p class="sr-only" aria-live="polite" data-icon-live></p>

  <ul class="icon-grid" data-icon-grid aria-label="Icons">
    {
      first.map((e) => {
        const style = preferredStyle(e);
        return (
          <li>
            <button
              type="button"
              class="icon-tile"
              aria-label={e.n}
              data-name={e.n}
              data-style={style}
              data-styles={Object.keys(e.s).join(',')}
              data-terms={[e.n, e.l, ...e.t].join(' ').toLowerCase()}
            >
              <span class="icon-tile__glyph" aria-hidden="true">
                <Icon name={e.n} style={style as 'solid' | 'regular' | 'brands'} size="1.6em" />
              </span>
              <span class="icon-tile__name" aria-hidden="true">{e.n}</span>
              <span class="icon-tile__copied" aria-hidden="true">
                Copied
              </span>
            </button>
          </li>
        );
      })
    }
  </ul>

  <p class="icon-more">
    <button type="button" data-icon-more>
      Show more icons
    </button>
  </p>

  <noscript>
    <p class="icon-nojs">
      Search and icons beyond the first {PAGE_SIZE} need JavaScript. These {PAGE_SIZE} are real,
      keyboard-usable tiles either way.
    </p>
  </noscript>

  <p class="icon-pro">
    Need a different look? Every icon here also comes in thin, light, sharp and duotone styles in a Superhero
    build. Browse the full Pro set at <a href="https://fontawesome.com/search">fontawesome.com/search</a> and
    send us the name.
  </p>
</div>

<script is:inline>
  document.querySelectorAll('[data-icon-gallery]').forEach((root) => {
    const grid = root.querySelector('[data-icon-grid]');
    const searchInput = root.querySelector('[data-icon-search]');
    const styleInputs = root.querySelectorAll('[data-icon-style]');
    const moreBtn = root.querySelector('[data-icon-more]');
    const status = root.querySelector('[data-icon-status]');
    const live = root.querySelector('[data-icon-live]');
    const src = root.dataset.iconSrc;
    const total = Number(root.dataset.iconTotal || '0');
    const PAGE = 200;

    const ssrTiles = Array.from(grid.querySelectorAll('.icon-tile'));
    let allData = null;
    let fetchPromise = null;
    let visible = PAGE;
    // Set only by an actual search/style interaction (or a "Show more" click) — not by the
    // unconditional render() at the bottom of this block — so the full icon-data.json fetch
    // stays genuinely on demand: a plain page load shows the first 200 without it.
    let interacted = false;

    const getStyle = () => (root.querySelector('[data-icon-style]:checked') || {}).value || 'all';
    const getQuery = () => (searchInput.value || '').trim().toLowerCase();

    function ensureData() {
      if (!fetchPromise) {
        status.textContent = `Loading the full set of ${total.toLocaleString()} icons…`;
        fetchPromise = fetch(src)
          .then((r) => r.json())
          .then((data) => {
            allData = data;
            render();
          })
          .catch(() => {
            status.textContent = 'Could not load the full icon set. Showing the first ' + ssrTiles.length + '.';
          });
      }
      return fetchPromise;
    }

    function svgFor(vb, d) {
      // Mirrors the Icon element's own markup (Icon.astro) — same sizing/colour contract,
      // just built by hand since these tiles are assembled from fetched path data, not
      // rendered through the Astro component.
      const ns = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(ns, 'svg');
      svg.setAttribute('viewBox', vb);
      svg.setAttribute('aria-hidden', 'true');
      svg.setAttribute('focusable', 'false');
      svg.setAttribute('style', 'width:1.6em;height:1.6em;color:var(--ic-color, currentColor)');
      const path = document.createElementNS(ns, 'path');
      path.setAttribute('fill', 'currentColor');
      path.setAttribute('d', d);
      svg.appendChild(path);
      return svg;
    }

    function pickStyle(entry, style) {
      if (style !== 'all' && entry.s[style]) return style;
      return entry.s.solid ? 'solid' : entry.s.regular ? 'regular' : 'brands';
    }

    function buildTile(entry, style) {
      const useStyle = pickStyle(entry, style);
      const [vb, d] = entry.s[useStyle];
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'icon-tile';
      btn.setAttribute('aria-label', entry.n);
      btn.dataset.name = entry.n;
      btn.dataset.style = useStyle;
      const glyph = document.createElement('span');
      glyph.className = 'icon-tile__glyph';
      glyph.setAttribute('aria-hidden', 'true');
      glyph.appendChild(svgFor(vb, d));
      const label = document.createElement('span');
      label.className = 'icon-tile__name';
      label.setAttribute('aria-hidden', 'true');
      label.textContent = entry.n;
      const copied = document.createElement('span');
      copied.className = 'icon-tile__copied';
      copied.setAttribute('aria-hidden', 'true');
      copied.textContent = 'Copied';
      btn.append(glyph, label, copied);
      li.appendChild(btn);
      return li;
    }

    function matchEntry(entry, style, q) {
      if (style !== 'all' && !entry.s[style]) return false;
      if (!q) return true;
      if (entry.n.includes(q) || entry.l.toLowerCase().includes(q)) return true;
      return entry.t.some((t) => t.includes(q));
    }

    function matchTile(tile, style, q) {
      if (style !== 'all' && (tile.dataset.styles || '').split(',').indexOf(style) === -1) return false;
      if (!q) return true;
      return (tile.dataset.terms || '').indexOf(q) !== -1;
    }

    function render() {
      const style = getStyle();
      const q = getQuery();

      if (allData) {
        const filtered = allData.filter((e) => matchEntry(e, style, q));
        const slice = filtered.slice(0, visible);
        grid.replaceChildren(...slice.map((e) => buildTile(e, style)));
        moreBtn.hidden = filtered.length <= visible;
        if (!moreBtn.hidden) moreBtn.textContent = `Show more icons (${filtered.length - visible} left)`;
        status.textContent = filtered.length
          ? `Showing ${slice.length} of ${filtered.length.toLocaleString()} icons.`
          : 'No icons match your search.';
        return;
      }

      let shown = 0;
      ssrTiles.forEach((tile) => {
        const ok = matchTile(tile, style, q);
        tile.hidden = !ok;
        if (ok) shown++;
      });
      const hasMore = style !== 'all' || !!q || total > ssrTiles.length;
      moreBtn.hidden = !hasMore;
      if (hasMore) moreBtn.textContent = 'Show more icons';
      if (hasMore && interacted) ensureData();
      status.textContent = `Showing ${shown} of the first ${ssrTiles.length} icons loaded (${total.toLocaleString()} total).`;
    }

    function copyIcon(btn) {
      const name = btn.dataset.name;
      const activeStyle = getStyle();
      const style = activeStyle !== 'all' ? activeStyle : btn.dataset.style || 'solid';
      const text = `icon: ${style} ${name}`;
      const announce = () => {
        btn.setAttribute('data-copied', 'true');
        live.textContent = `Copied: ${text}`;
        window.clearTimeout(btn._iconCopyTimer);
        btn._iconCopyTimer = window.setTimeout(() => btn.removeAttribute('data-copied'), 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(announce, announce);
      } else {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
        } catch (err) {
          /* clipboard unavailable; the visible/live confirmation still names the string to copy by hand */
        }
        document.body.removeChild(ta);
        announce();
      }
    }

    grid.addEventListener('click', (e) => {
      const btn = e.target.closest('.icon-tile');
      if (btn) copyIcon(btn);
    });

    searchInput.addEventListener('input', () => {
      interacted = true;
      visible = PAGE;
      render();
    });
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && searchInput.value) {
        searchInput.value = '';
        visible = PAGE;
        render();
      }
    });
    styleInputs.forEach((input) =>
      input.addEventListener('change', () => {
        interacted = true;
        visible = PAGE;
        render();
      }),
    );
    moreBtn.addEventListener('click', () => {
      interacted = true;
      if (allData) {
        visible += PAGE;
        render();
      } else {
        ensureData().then(() => {
          visible = Math.max(visible, ssrTiles.length + PAGE);
          render();
        });
      }
    });

    render();
  });
</script>

<style is:global>
  /* is:global, not Astro's default scoped styles: past the first 200, the grid's tiles are
     built by the inline script below from fetched icon-data.json, as plain DOM nodes that
     never get Astro's data-astro-cid-* scoping attribute. Scoped rules would silently stop
     applying to every tile the moment a search, a style filter or "Show more" replaces them,
     which is also every visit past the first page-load render. The "icon-" prefix keeps these
     rules from colliding with any other demo sharing the gallery index page. */
  .icon-gallery {
    color: var(--ink, #16192a);
  }
  .icon-patterns {
    list-style: none;
    display: grid;
    gap: 0.75rem 2rem;
    padding: 1rem 1.25rem;
    margin: 0 0 1.5rem;
    border: 1px dashed var(--line, #e6e6f0);
    border-radius: var(--radius, 14px);
  }
  @media (min-width: 40rem) {
    .icon-patterns {
      grid-template-columns: 1fr 1fr;
    }
  }
  .icon-pattern {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .icon-pattern p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--body, #565b73);
  }
  .icon-pattern code {
    background: var(--tint, #f8f8fc);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    color: var(--ink, #16192a);
  }
  .icon-pattern__btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--line, #e6e6f0);
    background: var(--white, #fff);
    color: var(--purple, #5933d8);
  }
  button.icon-pattern__btn[disabled] {
    cursor: default;
    opacity: 1;
  }
  .icon-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem 1.5rem;
    margin-bottom: 1rem;
  }
  .icon-search label {
    display: grid;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .icon-search input[type='search'] {
    font: inherit;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line, #e6e6f0);
    border-radius: 8px;
    min-width: 16rem;
    max-width: 100%;
    background: var(--white, #fff);
    color: inherit;
  }
  .icon-styles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .icon-styles legend {
    width: 100%;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.35rem;
    padding: 0;
  }
  .icon-chip {
    position: relative;
    display: inline-flex;
  }
  .icon-chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .icon-chip span {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line, #e6e6f0);
    font-size: 0.85rem;
    font-weight: 600;
    background: var(--white, #fff);
    color: var(--body, #565b73);
  }
  .icon-chip input:checked + span {
    background: var(--purple, #5933d8);
    border-color: var(--purple, #5933d8);
    color: #fff;
  }
  .icon-chip input:focus-visible + span {
    outline: 3px solid var(--purple, #5933d8);
    outline-offset: 2px;
  }
  .icon-status {
    font-size: 0.85rem;
    color: var(--muted, #868ba3);
    margin: 0 0 0.75rem;
  }
  .icon-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.75rem, 1fr));
    gap: 0.6rem;
  }
  .icon-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0.75rem 0.4rem;
    border: 1px solid var(--line, #e6e6f0);
    border-radius: var(--radius, 14px);
    background: var(--white, #fff);
    color: var(--ink, #16192a);
    font: inherit;
    cursor: pointer;
    overflow: hidden;
  }
  .icon-tile:hover {
    border-color: var(--purple, #5933d8);
  }
  .icon-tile__glyph {
    display: block;
    font-size: 1.5rem;
    line-height: 1;
  }
  .icon-tile__name {
    font-size: 0.7rem;
    font-family: var(--mono);
    text-align: center;
    overflow-wrap: anywhere;
  }
  .icon-tile__copied {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--purple, #5933d8);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
  }
  @media (prefers-reduced-motion: reduce) {
    .icon-tile__copied {
      transition: none;
    }
  }
  .icon-tile[data-copied] .icon-tile__copied {
    opacity: 1;
  }
  .icon-more {
    text-align: center;
    margin-top: 1rem;
  }
  .icon-more button {
    font: inherit;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    border: 1px solid var(--line, #e6e6f0);
    background: var(--white, #fff);
    color: inherit;
    cursor: pointer;
    font-weight: 700;
  }
  .icon-nojs {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--muted, #868ba3);
  }
  .icon-pro {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }
</style>
