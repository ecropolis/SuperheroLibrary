---
/**
 * Demo for `cart`. Neutral Goods, the library's fictional shop: the catalogue is
 * public/demo/shop-catalog.json and the stock public/demo/shop-stock.json, both in the Superhero
 * Shop Worker's shapes, with abstract SVG product images. Nothing here reaches a network: the
 * cart's `api` is https://shop.demo.invalid, and a small stub (installed once per page, before
 * any cart can fetch) answers that origin's /stock and /checkout and passes every other request
 * through untouched. The radios choose what the stubbed checkout answers, so each state can be
 * seen: Square's link, not enough stock (409 short), the shop closed (503), a network failure.
 * The demo cancels the cart's `cart-checkout` event, so it never leaves the page, and prints the
 * exact body the cart sent: ids, quantities, the fulfillment, a fresh key, and no price.
 *
 * `quiet` (the hub, where every demo shares a page): the cart starts empty. On its own page it
 * starts with two lines, one of them more than the stock holds, so opening the drawer shows the
 * stock re-check clamp it.
 */
import Cart from '../../library/cart/Cart.astro';
import fixture from '../../../public/demo/shop-catalog.json';
import stock from '../../../public/demo/shop-stock.json';

interface Props {
  /** Where public/demo/ is served. The gallery uses /demo/; the website passes /elements-demo/. */
  assetBase?: string;
  /** Many demos on one page: start with an empty cart. */
  quiet?: boolean;
}
const { assetBase = '/demo/', quiet = false } = Astro.props;
const asset = (name: string) => assetBase + name;
const catalog = { ...fixture, products: fixture.products.map((p) => ({ ...p, images: p.images.map(asset) })) };
const money = (c: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(c / 100);
const stub = `(() => {
  if (window.__shopDemo) return;
  const API = 'https://shop.demo.invalid';
  const stock = ${JSON.stringify(stock)};
  const state = { mode: 'ok' };
  window.__shopDemo = state;
  const real = window.fetch.bind(window);
  const later = (v, ms) => new Promise((ok) => setTimeout(() => ok(v), ms));
  const reply = (status, body) => later(new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } }), 450);
  window.fetch = (input, init) => {
    const url = typeof input === 'string' ? input : input.url;
    if (!url.startsWith(API + '/')) return real(input, init);
    const u = new URL(url);
    if (u.pathname.endsWith('/stock')) {
      const out = {};
      for (const id of (u.searchParams.get('ids') || '').split(',')) if (id in stock) out[id] = stock[id];
      return reply(200, out);
    }
    if (u.pathname.endsWith('/checkout')) {
      const body = JSON.parse(init.body);
      document.dispatchEvent(new CustomEvent('shop-demo-request', { detail: body }));
      if (state.mode === 'network') return new Promise((_, no) => setTimeout(() => no(new TypeError('Failed to fetch')), 450));
      if (state.mode === 'closed') return reply(503, { ok: false, error: 'shop_closed' });
      if (state.mode === 'short') {
        const first = body.items[0];
        return reply(409, { ok: false, error: 'short', short: [{ variationId: first.variationId, available: Math.max(0, first.quantity - 1) }] });
      }
      return reply(200, { url: 'https://square.link/u/demo' + body.idempotencyKey.replace(/-/g, '').slice(0, 8) });
    }
    return reply(404, { ok: false, error: 'not_found' });
  };
})();`;
const seed = quiet
  ? ''
  : `try { const k = 'superhero-cart:demo-cart'; if (!localStorage.getItem(k)) localStorage.setItem(k, JSON.stringify({ v: 1, lines: [{ id: 'VARMUGCREAM', q: 2 }, { id: 'VARCANDLELG', q: 3 }] })); } catch {}`;
---
<script is:inline set:html={stub + seed} />
<div class="demo-crt">
  <div class="demo-crt__bar">
    <p class="demo-crt__shop">Neutral Goods</p>
    <Cart
      id="demo-cart"
      shop="demo-cart"
      catalog={catalog}
      api="https://shop.demo.invalid"
      hrefBase={null}
      flatShippingCents={800}
      freeShippingOverCents={5000}
      pickupPoints={[
        { id: 'market', name: 'Saturday market', details: 'Stall 14, 8 am to noon' },
        { id: 'workshop', name: 'The workshop', details: 'Weekdays, 10 to 4' },
      ]}
    />
  </div>

  <ul class="demo-crt__products" role="list">
    {catalog.products.map((p) => (
      <li class="demo-crt__product">
        <img src={p.images[0]} alt="" width="96" height="96" loading="lazy" />
        <div>
          <p class="demo-crt__name">{p.name}</p>
          <div class="demo-crt__adds">
            {p.variations.map((v) => (
              <button type="button" class="demo-crt__add" data-cart-add={v.id} data-cart-shop="demo-cart" hidden>
                Add <span class="demo-crt__sr">{p.name}{p.variations.length > 1 ? ', ' : ''}</span>{p.variations.length > 1 ? v.name : ''} · {money(v.price_cents)}
              </button>
            ))}
          </div>
        </div>
      </li>
    ))}
  </ul>

  <fieldset class="demo-crt__modes">
    <legend>What the shop answers at checkout</legend>
    <label><input type="radio" name="demo-crt-mode" value="ok" checked /> A Square checkout link</label>
    <label><input type="radio" name="demo-crt-mode" value="short" /> Not enough stock (409)</label>
    <label><input type="radio" name="demo-crt-mode" value="closed" /> The shop is closed (503)</label>
    <label><input type="radio" name="demo-crt-mode" value="network" /> No connection</label>
  </fieldset>
  <div class="demo-crt__out" data-demo-crt-out hidden>
    <p data-demo-crt-went></p>
    <p class="demo-crt__label">The body the cart sent (ids and quantities, never a price):</p>
    <pre data-demo-crt-body></pre>
  </div>
</div>
<script is:inline>
  (() => {
    const root = document.currentScript.previousElementSibling;
    const out = root.querySelector('[data-demo-crt-out]');
    root.querySelector('.demo-crt__modes').addEventListener('change', (e) => {
      if (window.__shopDemo) window.__shopDemo.mode = e.target.value;
    });
    document.addEventListener('shop-demo-request', (e) => {
      if (!root.querySelector('#demo-cart-panel')?.open) return;
      out.hidden = false;
      out.querySelector('[data-demo-crt-body]').textContent = JSON.stringify(e.detail, null, 2);
      out.querySelector('[data-demo-crt-went]').textContent = '';
    });
    root.addEventListener('cart-checkout', (e) => {
      e.preventDefault();
      root.querySelector('#demo-cart-panel').close();
      out.hidden = false;
      out.querySelector('[data-demo-crt-went]').textContent = 'A real shop would now send the buyer to Square to pay: ' + e.detail.url;
    });
  })();
</script>

<style>
  .demo-crt {
    display: grid;
    gap: 1.25rem;
  }
  .demo-crt__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border: 1px solid #dfe3ea;
    border-radius: 12px;
  }
  .demo-crt__shop {
    margin: 0;
    font-weight: 700;
  }
  .demo-crt__products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .demo-crt__product {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .demo-crt__product img {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 8px;
  }
  .demo-crt__name {
    margin: 0 0 0.4rem;
    font-weight: 600;
  }
  .demo-crt__adds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .demo-crt__add {
    min-height: 2.75rem;
    padding: 0 0.8rem;
    border: 1px solid #5933d8;
    border-radius: 8px;
    background: #fff;
    color: #5933d8;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .demo-crt__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .demo-crt__add[hidden] {
    display: none;
  }
  .demo-crt__modes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px dashed #8a94a6;
    border-radius: 12px;
  }
  .demo-crt__modes label {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    min-height: 2.75rem;
  }
  .demo-crt__out p {
    margin: 0 0 0.5rem;
  }
  .demo-crt__out[hidden] {
    display: none;
  }
  .demo-crt__label {
    font-size: 0.875rem;
    color: #5b6577;
  }
  .demo-crt__out pre {
    margin: 0;
    padding: 0.75rem;
    overflow: auto;
    border-radius: 8px;
    background: #eef0f4;
    font-size: 0.8125rem;
  }
</style>
