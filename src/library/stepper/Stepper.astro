---
/**
 * Stepper — where someone is in a short sequence: Basket › Delivery › Payment › Review, or an
 * onboarding checklist. An ordered list of steps, each done, current or upcoming, joined by
 * connector lines; horizontal when it has the room, vertical below 40rem of its OWN width (so a
 * sidebar gets the vertical layout too). Behaviour and accessibility intent from Rocketbelt's
 * stepped progress indicator (Pier 1 Imports, 2020, MIT); reimplemented here, no code copied.
 *
 * Semantics: an <ol> (the order is the meaning, and the list announces "1 of 4"). The current
 * step's <li> carries aria-current="step". A done step says "Completed: " to screen readers
 * (visually hidden) and shows a check; a done step with an `href` is a link back to it. The
 * current and upcoming steps are never links, whatever `href` they carry: a link to where you
 * are is noise, and a link ahead skips the steps in between. When any step has an `href` the
 * whole thing is a <nav> named by `label`; otherwise the list itself is named by `label`, so
 * a purely visual stepper adds no landmark.
 *
 * `current` is the 1-based number of the current step; `steps.length + 1` means every step is
 * done (nothing is current).
 *
 * It is static: what the build renders is right without JavaScript. The one script (once per
 * page) is for a form that advances without a page load:
 *     window.__superheroStepper.go('checkout-steps', 3)
 * sets step 3 current, 1–2 done (linked when they have an href) and the rest upcoming, and
 * returns true (false for an unknown id or a non-number). It does not move focus or announce
 * anything: the form moving to its next section should move focus to that section's heading,
 * which is what a screen reader user needs to hear.
 *
 * Motion: the marker and line colours ease over 150 ms on go(); none under
 * prefers-reduced-motion.
 *
 * Theming, from the host's tokens (each has a fallback):
 *   --st-accent / --st-accent-fg   done and current markers, done lines / their number or check   (#5933d8 / #fff)
 *   --st-ring                      halo around the current marker                                 (accent at 22%)
 *   --st-upcoming                  upcoming marker ring and number                                (#6b6f80)
 *   --st-bg                        upcoming marker fill                                           (#fff)
 *   --st-line                      connector ahead of the current step                            (#d5d7e0)
 *   --st-fg / --st-muted           labels / upcoming labels and step text                         (inherit / #585c6e)
 *   --st-focus                     keyboard focus ring on links                                   (#5933d8)
 *   --st-size                      marker diameter                                                (2rem)
 *
 * The check is the Font Awesome Free 7.3.1 solid "check", inlined with its CC BY 4.0
 * attribution comment.
 */
export interface Step {
  label: string;
  /** A done step with an href links back to it. Ignored while the step is current or upcoming. */
  href?: string;
  /** A short line under the label. */
  text?: string;
}
interface Props {
  steps: Step[];
  /** 1-based number of the current step; steps.length + 1 = all done. Default 1. */
  current?: number;
  /** Accessible name: of the <nav>, or of the list when no step links. Default "Progress". */
  label?: string;
  /** 'auto' is horizontal from 40rem of its own width and vertical below; 'vertical' always. */
  orientation?: 'auto' | 'vertical';
  /** The id `go()` takes. Default: generated ("stepper-<n>"). */
  id?: string;
  class?: string;
}

const { steps, current = 1, label = 'Progress', orientation = 'auto', id: givenId, class: className } = Astro.props;

if (!Array.isArray(steps) || steps.length < 2) throw new Error('Stepper: `steps` needs at least two steps.');
for (const s of steps) if (!s.label || !String(s.label).trim()) throw new Error('Stepper: every step needs a label.');
if (!Number.isInteger(current) || current < 1 || current > steps.length + 1) throw new Error(`Stepper: current ${current} is not a step number from 1 to ${steps.length} (or ${steps.length + 1} for all done).`);
if (!['auto', 'vertical'].includes(orientation)) throw new Error(`Stepper: orientation "${orientation}" is not auto or vertical.`);
if (!label || !String(label).trim()) throw new Error('Stepper: `label` must not be empty; it names the progress list.');
if (givenId !== undefined && !/^[A-Za-z][\w-]*$/.test(givenId)) throw new Error(`Stepper: id "${givenId}" must start with a letter and hold only letters, digits, - and _.`);

// The same rule as the script's stStates (npm run check compares them on the built page).
const states = steps.map((_, i) => (i + 1 < current ? 'done' : i + 1 === current ? 'current' : 'upcoming'));

const locals = Astro.locals as Record<string, unknown>;
const n = ((locals.__stepperCount as number) || 0) + 1;
locals.__stepperCount = n;
const firstOnPage = !locals.__stepperScript;
locals.__stepperScript = true;
const id = givenId || `stepper-${n}`;
const linked = steps.some((s) => s.href);
const Root = linked ? 'nav' : 'div';

const check =
  '<svg class="st__check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-hidden="true" focusable="false"><!--! Font Awesome Free 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2026 Fonticons, Inc. --><path fill="currentColor" d="M434.8 70.1c14.3 10.4 17.5 30.4 7.1 44.7l-256 352c-5.5 7.6-14 12.3-23.4 13.1s-18.5-2.7-25.1-9.3l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l101.5 101.5 234-321.7c10.4-14.3 30.4-17.5 44.7-7.1z"/></svg>';
---

<Root class:list={['st', `st--${orientation}`, className]} id={id} data-st data-current={current} aria-label={linked ? label : undefined}>
  <ol class="st__list" aria-label={linked ? undefined : label}>
    {
      steps.map((s, i) => {
        const state = states[i];
        const Tag = state === 'done' && s.href ? 'a' : 'span';
        return (
          <li class:list={['st__step', `st__step--${state}`]} data-st-step data-href={s.href} aria-current={state === 'current' ? 'step' : undefined}>
            <Tag class="st__link" href={Tag === 'a' ? s.href : undefined}>
              <span class="st__marker" aria-hidden="true">
                <span class="st__num">{i + 1}</span>
                <Fragment set:html={check} />
              </span>
              <span class="st__words">
                <span class="st__label"><span class="st__sr">{state === 'done' ? 'Completed: ' : ''}</span>{s.label}</span>
                {s.text && <span class="st__text">{s.text}</span>}
              </span>
            </Tag>
          </li>
        );
      })
    }
  </ol>
</Root>

{
  firstOnPage && (
    <script is:inline>
      (() => {
        if (window.__superheroStepper) return;

        // <st-states> Pure: the state of each of `count` steps when step `n` is current.
        const stStates = (n, count) => Array.from({ length: count }, (_, i) => (i + 1 < n ? 'done' : i + 1 === n ? 'current' : 'upcoming'));
        // </st-states>

        const go = (id, n) => {
          const root = document.getElementById(id);
          if (!root || !root.matches('[data-st]') || typeof n !== 'number' || !Number.isFinite(n)) return false;
          const steps = [...root.querySelectorAll('[data-st-step]')];
          const to = Math.min(Math.max(1, Math.round(n)), steps.length + 1);
          stStates(to, steps.length).forEach((state, i) => {
            const li = steps[i];
            li.classList.remove('st__step--done', 'st__step--current', 'st__step--upcoming');
            li.classList.add('st__step--' + state);
            if (state === 'current') li.setAttribute('aria-current', 'step');
            else li.removeAttribute('aria-current');
            li.querySelector('.st__sr').textContent = state === 'done' ? 'Completed: ' : '';
            // A done step with an href is a link; every other step is text.
            const inner = li.querySelector('.st__link');
            const href = li.dataset.href;
            const wantLink = state === 'done' && !!href;
            if (wantLink !== (inner.tagName === 'A')) {
              const el = document.createElement(wantLink ? 'a' : 'span');
              for (const a of inner.attributes) if (a.name !== 'href') el.setAttribute(a.name, a.value);
              if (wantLink) el.setAttribute('href', href);
              el.append(...inner.childNodes);
              inner.replaceWith(el);
            }
          });
          root.dataset.current = String(to);
          return true;
        };
        window.__superheroStepper = { go };
      })();
    </script>
  )
}

<style>
  .st {
    container: st / inline-size;
    color: var(--st-fg, inherit);
  }
  /* A vertical stepper is a narrow container, so the one set of narrow rules below applies. */
  .st--vertical {
    max-width: 39.9rem;
  }
  .st__list {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .st__step {
    position: relative;
    margin: 0;
  }
  .st__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.35rem;
    color: inherit;
    text-align: center;
    text-decoration: none;
  }
  a.st__link:hover .st__label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  a.st__link:focus-visible {
    outline: 3px solid var(--st-focus, #5933d8);
    outline-offset: 4px;
    border-radius: 6px;
  }
  .st__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .st__marker {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex: none;
    box-sizing: border-box;
    width: var(--st-size, 2rem);
    height: var(--st-size, 2rem);
    border: 2px solid var(--st-upcoming, #6b6f80);
    border-radius: 50%;
    background: var(--st-bg, #fff);
    color: var(--st-upcoming, #6b6f80);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1;
  }
  .st__marker :global(.st__check) {
    display: none;
    width: 45%;
    height: 45%;
  }
  .st__step--done .st__marker,
  .st__step--current .st__marker {
    border-color: var(--st-accent, #5933d8);
    background: var(--st-accent, #5933d8);
    color: var(--st-accent-fg, #fff);
  }
  .st__step--current .st__marker {
    box-shadow: 0 0 0 4px var(--st-ring, color-mix(in srgb, var(--st-accent, #5933d8) 22%, transparent));
  }
  .st__step--done .st__num {
    display: none;
  }
  .st__step--done .st__marker :global(.st__check) {
    display: block;
  }

  .st__words {
    display: grid;
    gap: 0.15rem;
  }
  .st__label {
    font-weight: 600;
  }
  .st__step--current .st__label {
    font-weight: 800;
  }
  .st__step--upcoming .st__label {
    color: var(--st-muted, #585c6e);
    font-weight: 500;
  }
  .st__text {
    color: var(--st-muted, #585c6e);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  /* Connector from this step's marker to the next one's. */
  .st__step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(var(--st-size, 2rem) / 2 - 1px);
    left: calc(50% + var(--st-size, 2rem) / 2 + 0.5rem);
    right: calc(-50% + var(--st-size, 2rem) / 2 + 0.5rem);
    height: 2px;
    border-radius: 1px;
    background: var(--st-line, #d5d7e0);
  }
  .st__step--done:not(:last-child)::after {
    background: var(--st-accent, #5933d8);
  }

  /* Narrow (or orientation="vertical"): a column, markers on the left, lines running down. */
  @container st (max-width: 40rem) {
    .st__list {
      grid-auto-flow: row;
    }
    .st__link {
      flex-direction: row;
      align-items: flex-start;
      gap: 0.85rem;
      padding: 0 0 1.35rem;
      text-align: start;
    }
    .st__step:last-child .st__link {
      padding-bottom: 0;
    }
    .st__words {
      padding-top: calc((var(--st-size, 2rem) - 1.5em) / 2);
    }
    .st__step:not(:last-child)::after {
      top: calc(var(--st-size, 2rem) + 0.3rem);
      bottom: 0.3rem;
      left: calc(var(--st-size, 2rem) / 2 - 1px);
      right: auto;
      width: 2px;
      height: auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .st__marker,
    .st__step::after {
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, box-shadow 150ms ease;
    }
  }
  @media (forced-colors: active) {
    .st__step--done .st__marker,
    .st__step--current .st__marker {
      border-color: Highlight;
      background: Highlight;
      color: HighlightText;
      forced-color-adjust: none;
    }
    .st__step--done:not(:last-child)::after {
      background: Highlight;
      forced-color-adjust: none;
    }
  }
</style>
