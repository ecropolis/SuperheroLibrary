---
/**
 * Counter — a row of figures ("1,427 flights", "263 locations", "100% FAA certified") that
 * count up from `from` the first time they scroll into view, plain, inside a ring that fills,
 * or over a bar. Replaces UABB's Number Counter ("Numbers"), PowerPack's Counter, Elementor's
 * Counter and Progress widgets and countUp.js / jQuery counterUp.
 *
 * The final figure is in the HTML. Each figure renders its final, formatted text; the count is
 * a visual copy layered over it (aria-hidden), and the script straight after the element sets
 * that copy to `from` before the first paint, only when it is going to animate. So a screen
 * reader, a search engine, a visitor without JavaScript and one who prefers reduced motion all
 * get "1,427 flights" and never "0 flights". UABB ships `<span>0</span>` and an <h2> per figure;
 * here the figures are a list and nothing is a heading.
 *
 * No layout shift. The final text and the counting copy share one grid cell, with tabular
 * figures, so the box is as wide as the final value from the first frame.
 *
 * Motion. Starts once per figure at 40% visible, eases out over `duration`, staggered by
 * `stagger`. A timer finishes it if animation frames stop (a background tab), so nobody is left
 * on a half-counted number. prefers-reduced-motion (tracked live): no count, no ring fill.
 *
 * Theming (each has a fallback):
 *   --cn-accent     ring / bar fill and the figure's colour       (#5933d8)
 *   --cn-track      ring / bar track                               (#e6e8ef)
 *   --cn-fg         figure colour                                  (var(--cn-accent))
 *   --cn-label      label colour                                   (inherit)
 *   --cn-size       figure font size                               (clamp(2rem, 5vw, 3rem))
 *   --cn-ring       ring diameter                                  (11rem)
 *   --cn-ring-width ring thickness, in units of a 100-wide ring    (6)
 *   --cn-stroke     bar thickness                                  (6px)
 *   --cn-gap / --cn-min                                            (1.5rem / 10rem)
 */
export interface CounterItem {
  /** The final figure. */
  value: number;
  /** What it counts: "flights", "happy clients". Plain text. */
  label: string;
  /** Before the figure: "$", "+". */
  prefix?: string;
  /** After the figure: "%", "+", "k". */
  suffix?: string;
  /** For `style="ring"` / `"bar"`: the value of a full ring. Default: `value` (a full ring). */
  max?: number;
  /** A line under the label. Plain text. */
  note?: string;
}
interface Props {
  items: CounterItem[];
  /** 'plain' (default), 'ring' (UABB's circle), 'bar'. */
  style?: 'plain' | 'ring' | 'bar';
  /** Where every count starts. */
  from?: number;
  /** ms for one count. */
  duration?: number;
  /** ms between one figure's start and the next. */
  stagger?: number;
  /** Decimal places shown. */
  decimals?: number;
  /** Thousands separators ("1,427"). */
  grouping?: boolean;
  /** BCP 47 locale for the number format. */
  locale?: string;
  /** Name of the list for screen readers ("Our year in numbers"); none by default. */
  label?: string;
  align?: 'start' | 'center';
  class?: string;
}
const {
  items,
  style = 'plain',
  from = 0,
  duration = 1600,
  stagger = 150,
  decimals = 0,
  grouping = true,
  locale = 'en-US',
  label,
  align = 'center',
  class: className,
} = Astro.props;
if (!Array.isArray(items) || items.length === 0) throw new Error('Counter: `items` needs at least one figure.');
if (!['plain', 'ring', 'bar'].includes(style)) throw new Error(`Counter: \`style\` is plain, ring or bar; got "${style}".`);
for (const [i, it] of items.entries()) {
  if (typeof it.value !== 'number' || !Number.isFinite(it.value)) throw new Error(`Counter: item #${i + 1} needs a numeric \`value\`.`);
  if (!it.label || !String(it.label).trim()) throw new Error(`Counter: item #${i + 1} (${it.value}) needs a \`label\`, the words that say what it counts.`);
  if (it.max !== undefined && !(it.max > 0)) throw new Error(`Counter: item #${i + 1} has \`max\` ${it.max}; it must be above 0.`);
}
const fmt = new Intl.NumberFormat(locale, { minimumFractionDigits: decimals, maximumFractionDigits: decimals, useGrouping: grouping });
const share = (it: CounterItem) => Math.min(1, Math.max(0, it.value / ((it.max ?? it.value) || 1)));
const C = 2 * Math.PI * 45; // ring circumference in viewBox units
---

<ul
  class:list={['cn', `cn--${style}`, `cn--${align}`, className]}
  role="list"
  aria-label={label}
  data-cn
  data-from={from}
  data-duration={duration}
  data-stagger={stagger}
  data-locale={locale}
  data-decimals={decimals}
  data-grouping={grouping ? undefined : 'false'}
>
  {
    items.map((it) => (
      <li class="cn__item" data-cn-item data-value={it.value} data-share={share(it)}>
        <div class="cn__figure">
          {style === 'ring' && (
            <svg class="cn__ring" viewBox="0 0 100 100" aria-hidden="true">
              <circle class="cn__track" cx="50" cy="50" r="45" />
              <circle class="cn__fill" cx="50" cy="50" r="45" style={`stroke-dasharray:${C};stroke-dashoffset:${C * (1 - share(it))}`} data-c={C} />
            </svg>
          )}
          <span class="cn__num">
            <span class="cn__final">
              {it.prefix}
              {fmt.format(it.value)}
              {it.suffix}
            </span>
            <span class="cn__count" aria-hidden="true">
              {it.prefix}
              <span data-cn-digits>{fmt.format(it.value)}</span>
              {it.suffix}
            </span>
          </span>
        </div>
        {style === 'bar' && (
          <span class="cn__bar" aria-hidden="true">
            <span class="cn__barfill" style={`--cn-share:${share(it)}`} />
          </span>
        )}
        <span class="cn__label">{it.label}</span>
        {it.note && <span class="cn__note">{it.note}</span>}
      </li>
    ))
  }
</ul>
<script is:inline>
  (() => {
    const root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.matches('[data-cn]') || root.hasAttribute('data-ready')) return;
    root.setAttribute('data-ready', '');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    if (still.matches || !('IntersectionObserver' in window)) return;
    const from = Number(root.dataset.from) || 0;
    const duration = Math.max(0, Number(root.dataset.duration) || 0);
    const stagger = Math.max(0, Number(root.dataset.stagger) || 0);
    const dec = Number(root.dataset.decimals) || 0;
    let fmt;
    try {
      fmt = new Intl.NumberFormat(root.dataset.locale || undefined, {
        minimumFractionDigits: dec,
        maximumFractionDigits: dec,
        useGrouping: root.dataset.grouping !== 'false',
      });
    } catch {
      fmt = new Intl.NumberFormat();
    }
    const items = [...root.querySelectorAll('[data-cn-item]')];
    const ease = (t) => 1 - Math.pow(1 - t, 3);
    // Before the first paint: the visible copy starts at `from`, the ring and bar empty.
    const paint = (li, p) => {
      const to = Number(li.dataset.value);
      const share = Number(li.dataset.share);
      li.querySelector('[data-cn-digits]').textContent = fmt.format(from + (to - from) * p);
      const ring = li.querySelector('[data-c]');
      if (ring) ring.style.strokeDashoffset = String(Number(ring.dataset.c) * (1 - share * p));
      const bar = li.querySelector('.cn__barfill');
      if (bar) bar.style.setProperty('--cn-share', String(share * p));
    };
    const finish = (li) => {
      li.dataset.cnDone = '';
      paint(li, 1);
    };
    items.forEach((li) => paint(li, 0));
    root.setAttribute('data-armed', '');
    const run = (li, wait) => {
      let t0 = null;
      const backstop = setTimeout(() => finish(li), wait + duration + 250);
      const frame = (now) => {
        if (li.dataset.cnDone !== undefined) return;
        if (t0 === null) t0 = now + wait;
        const p = duration ? Math.min(1, Math.max(0, (now - t0) / duration)) : 1;
        paint(li, ease(p));
        if (p < 1) requestAnimationFrame(frame);
        else {
          clearTimeout(backstop);
          finish(li);
        }
      };
      requestAnimationFrame(frame);
    };
    let n = 0;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          run(e.target, n++ * stagger);
        }
        // Reset the stagger once a batch has started together.
        requestAnimationFrame(() => (n = 0));
      },
      { threshold: 0.4 },
    );
    items.forEach((li) => io.observe(li));
    // Reduced motion switched on mid-way: show the final figures now.
    still.addEventListener('change', (e) => {
      if (!e.matches) return;
      io.disconnect();
      items.forEach(finish);
    });
  })();
</script>

<style>
  .cn {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--cn-min, 10rem)), 1fr));
    gap: var(--cn-gap, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cn__item {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0.35rem;
    text-align: center;
  }
  .cn--start .cn__item {
    justify-items: start;
    text-align: start;
  }
  .cn__figure {
    position: relative;
    display: grid;
    place-items: center;
  }
  .cn--ring .cn__figure {
    width: var(--cn-ring, 11rem);
    max-width: 100%;
    aspect-ratio: 1;
    margin-bottom: 0.5rem;
  }
  .cn__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    rotate: -90deg;
  }
  .cn__track,
  .cn__fill {
    fill: none;
    stroke-width: var(--cn-ring-width, 6);
  }
  .cn__track {
    stroke: var(--cn-track, #e6e8ef);
  }
  .cn__fill {
    stroke: var(--cn-accent, #5933d8);
    stroke-linecap: round;
  }
  /* The final text and the counting copy share one cell: the box is the final width. */
  .cn__num {
    position: relative;
    display: grid;
    color: var(--cn-fg, var(--cn-accent, #5933d8));
    font-size: var(--cn-size, clamp(2rem, 5vw, 3rem));
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    white-space: nowrap;
  }
  .cn__final,
  .cn__count {
    grid-area: 1 / 1;
    justify-self: center;
  }
  .cn--start .cn__final,
  .cn--start .cn__count {
    justify-self: start;
  }
  /* Until the script arms it, the copy is hidden and the final text shows. */
  .cn__count {
    visibility: hidden;
  }
  .cn[data-armed] .cn__final {
    visibility: hidden;
  }
  .cn[data-armed] .cn__count {
    visibility: visible;
  }
  .cn--ring .cn__num {
    font-size: var(--cn-size, clamp(1.75rem, 4vw, 2.5rem));
  }
  .cn__bar {
    display: block;
    width: 100%;
    height: var(--cn-stroke, 6px);
    margin-block: 0.25rem;
    border-radius: 999px;
    background: var(--cn-track, #e6e8ef);
    overflow: hidden;
  }
  .cn__barfill {
    display: block;
    width: calc(var(--cn-share, 1) * 100%);
    height: 100%;
    border-radius: inherit;
    background: var(--cn-accent, #5933d8);
  }
  .cn__label {
    color: var(--cn-label, inherit);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .cn__note {
    color: var(--cn-label, inherit);
    font-size: 0.9rem;
    line-height: 1.4;
    opacity: 0.85;
  }
  @media print {
    .cn .cn__final {
      visibility: visible !important;
    }
    .cn .cn__count {
      visibility: hidden !important;
    }
  }
  @media (forced-colors: active) {
    .cn__fill,
    .cn__barfill {
      stroke: Highlight;
      background: Highlight;
    }
  }
</style>
