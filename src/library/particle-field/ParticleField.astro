---
/**
 * ParticleField — the "constellation" background: drifting dots, joined by a line
 * whenever two come within reach. This is what the WordPress site's hero had, via the
 * particle effect in Smart Slider 3 Pro (UABB's "Particle Background" row setting is the
 * same thing). Both bundle Vincent Garreau's particles.js (MIT); this is a dependency-free
 * rewrite of the subset they expose, with the same knobs and the same defaults, so a
 * WordPress config maps across one to one:
 *
 *   particles.number.value            → count          particles.size.value        → size
 *   particles.number.density.value_area → area         particles.opacity.value     → opacity
 *   particles.line_linked.distance    → linkDistance   particles.line_linked.opacity → linkOpacity
 *   particles.line_linked.width       → linkWidth      particles.move.speed        → speed
 *   mobile: 0                         → minWidth
 *
 * `count` is per `area` square px, as in particles.js: a 1200×500 hero at the defaults
 * gets about 33 particles, a full-screen one about 60. Dropped on purpose: hover/click
 * interactivity, shapes other than circles, size/opacity animation, image particles.
 *
 * Colour is the canvas's CSS `color`: set `--pf-color` (or `color`) on it from the host's tokens; the
 * fallback is white. The canvas is decorative and ignores pointer events. The host
 * positions it: it fills its nearest positioned ancestor, so give that ancestor
 * `position: relative` and put the canvas between the background and the copy in z order.
 *
 * Behaviour the original lacked: one static frame under prefers-reduced-motion (the look
 * without the movement), paused while off screen or in a hidden tab, devicePixelRatio
 * capped at 2, and particles are added or removed on resize instead of re-rolled.
 *
 *   <ParticleField class="hero__particles" />
 *   <ParticleField count={60} linkDistance={120} minWidth={0} />
 */
interface Props {
  count?: number;
  area?: number;
  size?: number;
  opacity?: number;
  linkDistance?: number;
  linkOpacity?: number;
  linkWidth?: number;
  speed?: number;
  /** Viewport width (px) below which nothing is drawn. 0 draws everywhere. */
  minWidth?: number;
  class?: string;
}
const {
  count = 44,
  area = 800,
  size = 3,
  opacity = 0.48,
  linkDistance = 150,
  linkOpacity = 0.48,
  linkWidth = 1,
  speed = 2,
  minWidth = 700,
  class: className,
} = Astro.props;
---

<canvas
  class:list={['particles', className]}
  aria-hidden="true"
  data-particles
  data-count={count}
  data-area={area}
  data-size={size}
  data-opacity={opacity}
  data-link-distance={linkDistance}
  data-link-opacity={linkOpacity}
  data-link-width={linkWidth}
  data-speed={speed}
  data-min-width={minWidth}
></canvas>

<script is:inline>
  (() => {
    if (window.__particleField) return;
    window.__particleField = true;

    const init = (canvas) => {
      if (canvas.dataset.ready) return;
      canvas.dataset.ready = '1';
      const n = (k, d) => {
        const v = parseFloat(canvas.dataset[k]);
        return Number.isFinite(v) ? v : d;
      };
      const cfg = {
        count: n('count', 44),
        area: n('area', 800),
        size: n('size', 3),
        opacity: n('opacity', 0.48),
        linkDistance: n('linkDistance', 150),
        linkOpacity: n('linkOpacity', 0.48),
        linkWidth: n('linkWidth', 1),
        speed: n('speed', 2),
        minWidth: n('minWidth', 0),
      };
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const small = cfg.minWidth ? matchMedia(`(max-width: ${cfg.minWidth - 1}px)`) : null;
      const off = () => !!small && small.matches;
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const dots = [];
      let w = 0, h = 0, dpr = 1, raf = 0, last = 0, visible = true;

      const spawn = () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.max(0.5, Math.random() * cfg.size),
        vx: Math.random() - 0.5,
        vy: Math.random() - 0.5,
      });

      const resize = () => {
        const box = canvas.getBoundingClientRect();
        w = Math.max(1, Math.round(box.width));
        h = Math.max(1, Math.round(box.height));
        dpr = Math.min(2, window.devicePixelRatio || 1);
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        // particles.js density: N per `area` thousand-px², in CSS pixels.
        const want = Math.max(1, Math.round((cfg.count * (w * h)) / 1000 / cfg.area));
        while (dots.length < want) dots.push(spawn());
        dots.length = Math.min(dots.length, want);
        for (const d of dots) { d.x = Math.min(d.x, w); d.y = Math.min(d.y, h); }
      };

      const draw = () => {
        ctx.clearRect(0, 0, w, h);
        if (off()) return;
        const color = getComputedStyle(canvas).color;
        ctx.fillStyle = color;
        ctx.strokeStyle = color;
        ctx.lineWidth = cfg.linkWidth;
        if (cfg.linkDistance > 0) {
          for (let i = 0; i < dots.length; i++) {
            for (let j = i + 1; j < dots.length; j++) {
              const dx = dots[i].x - dots[j].x, dy = dots[i].y - dots[j].y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist > cfg.linkDistance) continue;
              ctx.globalAlpha = cfg.linkOpacity * (1 - dist / cfg.linkDistance);
              ctx.beginPath();
              ctx.moveTo(dots[i].x, dots[i].y);
              ctx.lineTo(dots[j].x, dots[j].y);
              ctx.stroke();
            }
          }
        }
        ctx.globalAlpha = cfg.opacity;
        for (const d of dots) {
          ctx.beginPath();
          ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      };

      const step = (t) => {
        raf = 0;
        const frames = last ? Math.min(3, (t - last) / (1000 / 60)) : 1;
        last = t;
        const ms = (cfg.speed / 2) * frames;
        for (const d of dots) {
          d.x += d.vx * ms;
          d.y += d.vy * ms;
          // particles.js out_mode "out": leave one edge, re-enter at the opposite one.
          if (d.x - d.r > w) { d.x = -d.r; d.y = Math.random() * h; }
          else if (d.x + d.r < 0) { d.x = w + d.r; d.y = Math.random() * h; }
          if (d.y - d.r > h) { d.y = -d.r; d.x = Math.random() * w; }
          else if (d.y + d.r < 0) { d.y = h + d.r; d.x = Math.random() * w; }
        }
        draw();
        schedule();
      };

      const schedule = () => {
        if (still || raf || !visible || document.hidden || off()) return;
        raf = requestAnimationFrame(step);
      };
      const halt = () => { if (raf) cancelAnimationFrame(raf); raf = 0; last = 0; };

      resize();
      draw();
      // Tracked, not decided once: a phone turned sideways or a narrow window widened
      // gets the field; narrowed, it clears.
      small?.addEventListener('change', () => { resize(); draw(); off() ? halt() : schedule(); });
      // Setting canvas.width wipes the bitmap, so every resize redraws: a paused or
      // static field must not go blank because the box changed.
      new ResizeObserver(() => { resize(); draw(); }).observe(canvas);
      if (still) return;
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        visible ? schedule() : halt();
      }).observe(canvas);
      document.addEventListener('visibilitychange', () => (document.hidden ? halt() : schedule()));
      schedule();
    };

    const boot = () => document.querySelectorAll('canvas[data-particles]').forEach(init);
    document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', boot) : boot();
  })();
</script>

<style>
  .particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--pf-color, #fff);
  }
</style>
