---
/**
 * CookieConsent — self-hosted consent bar plus consent-gated Google Tag Manager
 * loading. No third-party CMP, no dependencies.
 *
 * @version 2.1.0
 *
 * ───────────────────────────────────────────────────────────────────────────
 * CANONICAL SOURCE: ecropolis/ecropolis-consent
 *
 * Do NOT edit this file inside a site repo. It is copied in by
 * `consent-sync update <site>`, so a local edit is silently overwritten on the
 * next sync and never reaches the other sites.
 *
 * Fix it upstream, bump the version, sync. Anything one site needs to differ
 * on becomes a PROP, not a fork — that is what `copy` and `storageKey` are for.
 * ───────────────────────────────────────────────────────────────────────────
 *
 * TWO MODES, set with the `mode` prop:
 *
 *  - 'opt-out' (implied consent) — analytics load immediately on the first
 *    visit. The bar tells the visitor they can opt out; Decline stops it. This
 *    is the normal US model and it costs you almost no measurement.
 *
 *  - 'opt-in' (prior consent) — nothing is fetched from Google until the
 *    visitor accepts. Loading the container with consent denied would still
 *    send their IP to Google, which is the thing being avoided.
 *
 * `strictRegions` (default true) forces 'opt-in' for visitors who look like
 * they are in the EEA / UK / Switzerland, where GDPR + ePrivacy require prior
 * consent and implied consent is not a lawful basis. Detection is the browser's
 * own IANA time zone (`Intl.DateTimeFormat().resolvedOptions().timeZone`) — no
 * Geolocation API, no permission prompt, no IP lookup, no network call. It is a
 * heuristic: a VPN or a traveller will be misread in both directions, and it
 * errs toward strict when the zone cannot be read at all.
 *
 * Other behaviour:
 *  - Renders NOTHING unless `gtmId` is set, so analytics stay fully off and the
 *    privacy policy's no-tracker stance stays true until a container exists.
 *  - Analytics-only: ad storage and personalization stay denied even on accept
 *    unless `enableAds` is set.
 *  - Declining after analytics already loaded (only possible in opt-out mode,
 *    and only on that one page view) updates Consent Mode to denied, sets GA's
 *    own `ga-disable-*` kill switch, and deletes any `_ga*` cookies already
 *    written. Later page views never load the container at all.
 *  - The choice persists in localStorage and is reversible — any element with
 *    `data-cc-reopen` re-opens the bar.
 *  - Delegated click tracking pushes conversion events into the dataLayer.
 *    Pushing before consent is harmless: the dataLayer is a local array and
 *    nothing leaves the browser until GTM loads.
 *
 * Note the two inline scripts of the earlier version are deliberately ONE now:
 * the Consent Mode default push has to run after the region check, so it cannot
 * live in a separate earlier block.
 */
interface Conversion {
  match: string;
  event: string;
}
interface Props {
  gtmId?: string;
  /** GA4 measurement ID, e.g. G-XXXXXXXXXX. Enables the hard kill switch on decline. */
  gaMeasurementId?: string;
  /** 'opt-out' = load analytics until declined. 'opt-in' = load nothing until accepted. */
  mode?: 'opt-in' | 'opt-out';
  /** Force opt-in for EEA / UK / Swiss visitors regardless of `mode`. */
  strictRegions?: boolean;
  conversions?: readonly Conversion[];
  privacyHref?: string;
  /** Per-site localStorage key, e.g. 'gg_consent'. Always pass one. */
  storageKey?: string;
  enableAds?: boolean;
  /**
   * Override the banner wording per site. Partial — anything omitted falls back
   * to the default below. Use this instead of forking the file for copy tweaks.
   */
  copy?: Partial<Record<'opt-in' | 'opt-out', Partial<{ text: string; accept: string }>>>;
}
const {
  gtmId = '',
  gaMeasurementId = '',
  mode = 'opt-out',
  strictRegions = true,
  conversions = [],
  privacyHref = '/privacy',
  storageKey = 'cc_consent',
  enableAds = false,
  copy = {},
} = Astro.props;

// define:vars cannot serialize a readonly tuple — hand the runtime a plain array.
const conversionList = conversions.map((c) => ({ match: c.match, event: c.event }));

/**
 * Copy for each mode. The bar is `hidden` until the runtime resolves the
 * effective mode, so swapping these client-side never flashes the wrong text.
 */
const DEFAULT_COPY = {
  'opt-out': {
    text: "We use analytics cookies to understand how this site is used. Decline to opt out — we'll remember your choice.",
    accept: 'OK',
  },
  'opt-in': {
    text: "We use analytics cookies to understand how this site is used. Accept or decline — we'll remember your choice.",
    accept: 'Accept',
  },
};

const COPY = {
  'opt-out': { ...DEFAULT_COPY['opt-out'], ...(copy['opt-out'] ?? {}) },
  'opt-in': { ...DEFAULT_COPY['opt-in'], ...(copy['opt-in'] ?? {}) },
};
---

{gtmId && (
  <>
    <div class="cc-banner" id="cc-banner" role="dialog" aria-label="Cookie consent" hidden>
      <p class="cc-text">
        <span data-cc-copy>{COPY[mode].text}</span>
        {' '}See our <a href={privacyHref}>Privacy Policy</a>.
      </p>
      <div class="cc-actions">
        <button type="button" class="cc-btn cc-decline" data-cc="decline">Decline</button>
        <button type="button" class="cc-btn cc-accept" data-cc="accept">{COPY[mode].accept}</button>
      </div>
    </div>

    <script
      is:inline
      define:vars={{ gtmId, gaMeasurementId, mode, strictRegions, conversionList, storageKey, enableAds, COPY }}
    >
      (function () {
        var banner = document.getElementById('cc-banner');
        var gtmLoaded = false;

        /**
         * EEA + UK + Switzerland by IANA time zone. Everything in the EEA sits
         * under `Europe/` except these outlying-territory zones. A handful of
         * `Europe/` zones are not EEA at all (Moscow, Istanbul, Minsk) — being
         * strict there is the harmless direction to be wrong in.
         */
        var STRICT_ZONES = [
          'Atlantic/Azores',
          'Atlantic/Canary',
          'Atlantic/Faroe',
          'Atlantic/Madeira',
          'Atlantic/Reykjavik',
          'America/Cayenne',
          'America/Guadeloupe',
          'America/Martinique',
          'America/Miquelon',
          'Indian/Mayotte',
          'Indian/Reunion',
        ];

        function looksEuropean() {
          try {
            var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            return tz.indexOf('Europe/') === 0 || STRICT_ZONES.indexOf(tz) !== -1;
          } catch (e) {
            // No readable time zone — assume the stricter rules apply.
            return true;
          }
        }

        var effective = mode === 'opt-out' && strictRegions && looksEuropean() ? 'opt-in' : mode;

        function consent(granted) {
          var ad = granted && enableAds ? 'granted' : 'denied';
          return {
            analytics_storage: granted ? 'granted' : 'denied',
            ad_storage: ad,
            ad_user_data: ad,
            ad_personalization: ad,
          };
        }

        var stored = null;
        try { stored = localStorage.getItem(storageKey); } catch (e) {}

        // Consent Mode defaults. A stored choice wins; otherwise opt-out mode
        // starts granted and opt-in mode starts denied.
        var startGranted = stored === 'granted' || (stored !== 'denied' && effective === 'opt-out');
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
        window.gtag('consent', 'default', Object.assign(
          { functionality_storage: 'granted', security_storage: 'granted' },
          consent(startGranted)
        ));

        function loadGTM() {
          if (gtmLoaded) return;
          gtmLoaded = true;
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0];
            var j = d.createElement(s);
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', gtmId);
        }

        /**
         * Analytics may already have written cookies before a decline in
         * opt-out mode. Consent Mode stops future writes; this removes what is
         * already there, across every domain scope GA might have used.
         */
        function clearAnalyticsCookies() {
          var host = location.hostname;
          var scopes = ['', host, '.' + host];
          var parts = host.split('.');
          if (parts.length > 2) scopes.push('.' + parts.slice(-2).join('.'));
          document.cookie.split(';').forEach(function (pair) {
            var name = pair.split('=')[0].trim();
            // _gcl_* comes from GTM's conversion linker, which fires even with
            // ad_storage denied — clear it on decline too.
            if (!/^(_ga|_gid|_gat|_gcl)/.test(name)) return;
            scopes.forEach(function (d) {
              document.cookie = name + '=; Max-Age=0; path=/' + (d ? '; domain=' + d : '');
            });
          });
        }

        function grant() {
          if (gaMeasurementId) window['ga-disable-' + gaMeasurementId] = false;
          window.gtag('consent', 'update', consent(true));
          loadGTM();
        }
        function deny() {
          // Hard stop first — GA checks this flag on every hit it tries to send.
          if (gaMeasurementId) window['ga-disable-' + gaMeasurementId] = true;
          window.gtag('consent', 'update', consent(false));
          clearAnalyticsCookies();
        }
        function hide() { if (banner) banner.hidden = true; }
        function show() {
          if (!banner) return;
          var copy = COPY[effective];
          var text = banner.querySelector('[data-cc-copy]');
          var accept = banner.querySelector('[data-cc="accept"]');
          if (text) text.textContent = copy.text;
          if (accept) accept.textContent = copy.accept;
          banner.hidden = false;
        }

        if (stored === 'granted') {
          grant();
        } else if (stored === 'denied') {
          deny();
        } else {
          // No decision yet. Opt-out mode measures while the bar is showing;
          // opt-in mode waits.
          if (effective === 'opt-out') grant();
          show();
        }

        if (banner) {
          banner.addEventListener('click', function (e) {
            var b = e.target.closest('[data-cc]');
            if (!b) return;
            var accepted = b.getAttribute('data-cc') === 'accept';
            try { localStorage.setItem(storageKey, accepted ? 'granted' : 'denied'); } catch (e) {}
            if (accepted) grant(); else deny();
            hide();
          });
        }

        // "Cookie settings" — let a visitor change their mind at any time.
        document.addEventListener('click', function (e) {
          var r = e.target.closest('[data-cc-reopen]');
          if (r) { e.preventDefault(); show(); }
        });

        // Delegated conversion tracking.
        document.addEventListener('click', function (e) {
          var el = e.target.closest('a, [data-analytics]');
          if (!el) return;
          var ev = null;
          if (el.dataset && el.dataset.analytics) {
            ev = el.dataset.analytics;
          } else {
            var href = el.getAttribute('href') || '';
            for (var i = 0; i < conversionList.length; i++) {
              if (href.indexOf(conversionList[i].match) !== -1) {
                ev = conversionList[i].event;
                break;
              }
            }
          }
          if (!ev) return;
          window.dataLayer.push({
            event: ev,
            cta_text: (el.textContent || '').trim().slice(0, 80),
            link_url: (el.getAttribute && el.getAttribute('href')) || '',
            page_path: location.pathname,
          });
        });
      })();
    </script>
  </>
)}

<style>
  /**
   * Theming contract.
   *
   * Every colour here is a `--cc-*` variable that the site sets on :root. The
   * widget deliberately reads NO site tokens directly: it used to reference
   * --cream / --red / --ink-soft / --font-sans, which exist only in Zingfling's
   * palette, so on the other six sites every fallback applied and the bar
   * rendered as a cream panel with a #d5261c red button — another brand's
   * colours, on brand pages, for months.
   *
   * The defaults below are palette-neutral. An unthemed site looks deliberate
   * rather than borrowed, and its own colours are one :root block away.
   *
   * --cc-accent must clear 4.5:1 against --cc-accent-ink. The buttons are
   * 13.5px, which is not WCAG "large text", so a mid-tone brand colour usually
   * fails: prefer the site's dark surface tone over its primary CTA colour. A
   * consent bar is system UI — it should not compete with the real CTAs.
   */
  .cc-banner {
    --_bg: var(--cc-bg, #eef2f1);
    --_border: var(--cc-border, #cfdad7);
    --_text: var(--cc-text, #4c5a60);
    --_ink: var(--cc-ink, #1d2b30);
    --_link: var(--cc-link, #1f4f55);
    --_accent: var(--cc-accent, #1f4f55);
    --_accent-hover: var(--cc-accent-hover, #143a3f);
    --_accent-ink: var(--cc-accent-ink, #fff);
    --_radius: var(--cc-radius, 14px);
    --_radius-btn: var(--cc-radius-btn, 10px);
  }

  /* Must come first: the display:flex below would otherwise beat [hidden]. */
  .cc-banner[hidden] { display: none; }

  .cc-banner {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 120;
    width: min(780px, calc(100% - 2rem));
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.9rem 1.4rem;
    padding: 1rem 1.25rem;
    /* A tinted panel, not a floating white sheet. */
    background: var(--_bg);
    border: 1px solid var(--_border);
    border-radius: var(--_radius);
    box-shadow: var(--cc-shadow, 0 14px 40px rgba(16, 32, 36, .18));
    font-family: var(--cc-font, inherit);
  }
  .cc-text {
    margin: 0;
    flex: 1 1 320px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--_text);
  }
  .cc-text a {
    color: var(--_link);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cc-actions { display: flex; gap: 0.6rem; flex: 0 0 auto; }
  .cc-btn {
    font-family: inherit;
    font-weight: 600;
    font-size: 13.5px;
    line-height: 1;
    /* 44px minimum tap target */
    padding: 0.9rem 1.3rem;
    min-height: 44px;
    border-radius: var(--_radius-btn);
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .cc-decline {
    background: transparent;
    color: var(--_ink);
    border-color: var(--_border);
  }
  .cc-decline:hover { border-color: var(--_ink); }
  .cc-accept {
    background: var(--_accent);
    border-color: var(--_accent);
    color: var(--_accent-ink);
  }
  .cc-accept:hover {
    background: var(--_accent-hover);
    border-color: var(--_accent-hover);
  }

  @media (max-width: 560px) {
    .cc-banner {
      left: 0;
      bottom: 0;
      width: 100%;
      transform: none;
      border-radius: 0;
      border-inline: 0;
      border-bottom: 0;
    }
    .cc-actions { width: 100%; }
    .cc-btn { flex: 1; }
  }
</style>
