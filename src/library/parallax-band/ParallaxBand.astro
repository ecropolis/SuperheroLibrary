---
/**
 * ParallaxBand — a full-width band whose background image scrolls slower than the page, with an
 * optional tint and content on top. Page builders call it a parallax row or section
 * (Elementor "Motion effects → Scrolling effects", Beaver Builder's "Parallax" row background).
 *
 * It is a transform driven from the scroll position in requestAnimationFrame, not
 * `background-attachment: fixed`: iOS Safari ignores `fixed` (or repaints the whole page with
 * it), so the old trick is static at best on half of all visits.
 *
 * `speed` is how much the image lags, 0–1: 0 scrolls with the page, 1 holds it still, 0.3–0.5
 * reads as depth without drawing attention. The script makes the image taller than the band
 * by just enough that its edges never show; the band crops it (`object-fit: cover`, framed by
 * `position`), so use a wide image whose subject survives a crop, at least 1.5× the band's
 * height at the widest viewport.
 *
 * Without JavaScript, and under prefers-reduced-motion (tracked live), the image is a plain
 * static cover background. Off screen, the scroll handler does nothing.
 *
 * Sizing: the band fills its width and is at least `height` tall (prop, else `--pb-height`,
 * fallback 60vh); the content grows it. Stacking is internal (image, tint, content); the band
 * clips its image, so put nothing that has to overflow it inside.
 *
 * Theming, from the host's tokens (each has a fallback):
 *   --pb-bg                      colour behind the image while it loads    (#222)
 *   --pb-overlay / --pb-overlay-opacity  tint colour and strength          (#000 / 0.35)
 *   --pb-fg                      content text colour                        (#fff)
 *   --pb-height                  minimum height                             (60vh)
 */
interface Props {
  /** Background image URL. Decorative: it gets empty alt text. */
  image: string;
  /** Intrinsic size of the image, to avoid layout shift. */
  width?: number;
  height?: number;
  /** How much the image lags the page, 0–1. */
  speed?: number;
  /** Tint strength, 0–1. Overrides --pb-overlay-opacity when set. */
  overlay?: number;
  /** Minimum height of the band, any CSS length. Overrides --pb-height when set. */
  minHeight?: string;
  /** object-position of the image, e.g. 'center 30%'. */
  position?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const {
  image,
  width,
  height,
  speed = 0.4,
  overlay,
  minHeight,
  position = 'center',
  loading = 'lazy',
  class: className,
} = Astro.props;
const s = Math.min(1, Math.max(0, speed));
const style = [
  overlay === undefined ? '' : `--pb-overlay-opacity:${overlay}`,
  minHeight === undefined ? '' : `--pb-height:${minHeight}`,
]
  .filter(Boolean)
  .join(';');
---

<div class:list={['pb', className]} style={style || undefined} data-pb data-speed={s}>
  <img
    class="pb__media"
    src={image}
    alt=""
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    style={`object-position:${position}`}
    data-pb-media
  />
  <div class="pb__tint" aria-hidden="true"></div>
  <div class="pb__content"><slot /></div>
</div>

<script is:inline>
  (() => {
    if (window.__parallaxBand) return;
    window.__parallaxBand = true;
    const still = matchMedia('(prefers-reduced-motion: reduce)');

    const init = (band) => {
      if (band.dataset.ready) return;
      band.dataset.ready = '1';
      const media = band.querySelector('[data-pb-media]');
      const speed = parseFloat(band.dataset.speed) || 0;
      if (!speed) return;
      let visible = false;
      let raf = 0;
      let bh = 0;
      let vh = 0;

      const size = () => {
        bh = band.offsetHeight;
        vh = window.innerHeight;
        const extra = speed * (vh + bh);
        media.style.top = `${-extra / 2}px`;
        media.style.height = `${bh + extra}px`;
      };
      const frame = () => {
        raf = 0;
        const r = band.getBoundingClientRect();
        // Distance of the band's centre below the viewport's centre; the image moves back by a
        // share of it, so on screen it travels (1 - speed) as far as the page.
        const offset = r.top + r.height / 2 - vh / 2;
        media.style.transform = `translate3d(0, ${(-offset * speed).toFixed(1)}px, 0)`;
      };
      const request = () => {
        if (!raf && visible && band.classList.contains('pb--live')) raf = requestAnimationFrame(frame);
      };
      const apply = () => {
        const live = !still.matches;
        band.classList.toggle('pb--live', live);
        if (live) { size(); frame(); }
        else { media.style.top = media.style.height = media.style.transform = ''; }
      };

      new IntersectionObserver(([e]) => { visible = e.isIntersecting; request(); }).observe(band);
      addEventListener('scroll', request, { passive: true });
      new ResizeObserver(() => { if (band.classList.contains('pb--live')) { size(); frame(); } }).observe(band);
      addEventListener('resize', () => { if (band.classList.contains('pb--live')) { size(); frame(); } });
      still.addEventListener('change', apply);
      apply();
    };

    const boot = () => document.querySelectorAll('[data-pb]').forEach(init);
    document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', boot) : boot();
  })();
</script>

<style>
  .pb {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    min-height: var(--pb-height, 60vh);
    background: var(--pb-bg, #222);
    color: var(--pb-fg, #fff);
  }
  .pb__media,
  .pb__tint {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .pb__media {
    z-index: -2;
    max-width: none;
    object-fit: cover;
  }
  .pb--live .pb__media {
    bottom: auto;
    will-change: transform;
  }
  .pb__tint {
    z-index: -1;
    background: var(--pb-overlay, #000);
    opacity: var(--pb-overlay-opacity, 0.35);
  }
  .pb__content {
    position: relative;
    display: grid;
    align-content: center;
    padding: clamp(1.5rem, 5vw, 4rem);
  }
</style>
