---
/**
 * ImageEffects — one file, several named effects for photographs. Hover effects on one image,
 * a tile fly-in slideshow for a hero, and a scroll-opened gallery strip. Pick one with `effect`.
 * New effects are added here, to EFFECTS below, with a demo cell and a catalogue line.
 *
 * On one image, on hover (and on keyboard focus when the image is a link, `href`):
 *   pixelate      the photo breaks into blocks and resolves again: a canvas laid over it is
 *                 redrawn at 40, 10, 4, 10 and 40% of its size, 100 ms apart, smoothing off,
 *                 then removed at 500 ms. Rebuilt from the Aine theme's image-gallery.min.js
 *                 for the MLP Technologies rebuild (2026-10-29), step for step.
 *   zoom          the photo pushes in slowly inside its frame
 *   grayscale     black and white at rest, colour on hover
 *   duotone       two brand colours at rest (--ie-duo-dark, --ie-duo-light), the photo on hover
 *   tilt          the frame leans toward the pointer in 3D with a soft glare (fine pointers only)
 *   shine         a band of light sweeps across once
 *   caption       the caption slides up over the photo; always shown where nothing can hover
 *
 * On several images:
 *   tiles         a slideshow whose photo arrives as a 7×7 grid of tiles, each flying in from
 *                 below with a random offset, turn and scale, 45 ms apart over 1 s, easing out
 *                 (power3.out). The title enters from the left with a 45° skew, the text fades,
 *                 the button rises. 10 s a slide. Slider Revolution's slide-based tile
 *                 transition, rebuilt with the Web Animations API for MLP Technologies.
 *   gallery-open  three or five photos in a strip; as the strip scrolls up past the middle of
 *                 the screen the centre photo un-clips to the full width and the others slide
 *                 out. The Aine theme's "image gallery hero", driven by --p1 / --p2.
 *
 * The rules every effect keeps:
 *   - Without JavaScript every effect is a plain image (tiles: the first slide, still, with its
 *     words; gallery-open: the strip). The CSS-only effects need no script at all.
 *   - prefers-reduced-motion, tracked live: nothing moves. pixelate, zoom, tilt and shine do
 *     nothing; grayscale, duotone and caption change at once; tiles shows each slide whole,
 *     never advances by itself and has no pause button; gallery-open stays a strip.
 *     tiles with autoplay={false} moves only with its arrows and has no pause button.
 *   - A linked image (`href`) shows on :focus-visible exactly what it shows on hover, and the
 *     focus ring stays. An unlinked image is not focusable, so its effect is hover only: it
 *     never carries meaning, only the photo does.
 *   - Every photo keeps its alt text. Canvases, tiles and glare are aria-hidden and ignore the
 *     pointer.
 *   - tiles: WCAG 2.2.2. While it can advance by itself it has a visible 44px pause button,
 *     named for what it will do; it also waits on hover, on focus inside, off screen and in a
 *     hidden tab. Slides are groups named "2 of 3"; the ones not showing are inert.
 *
 * Styles are global (every class `ie-`), because canvases, tiles and glare are made by the
 * script and never get Astro's scope attribute. The runtime ships with the first instance on a
 * page; each instance mounts itself from the one-line script straight after it, before the first
 * paint, so a tile slideshow never flashes its photo before the fly-in. Keep that script there.
 *
 * Pattern sources (reimplemented, no code copied): pixelate, tiles and gallery-open from the
 * MLP Technologies rebuild of the Aine theme and Slider Revolution; tilt after vanilla-tilt.js
 * (micku7zu, MIT); caption, zoom and shine after imagehover.css (ciar4n, MIT).
 *
 * Theming, from the host's tokens (each has a fallback):
 *   --ie-radius        frame corners                                          (0)
 *   --ie-bg            behind a photo while it loads                          (#1e283c)
 *   --ie-duration      hover transitions                                      (0.6s)
 *   --ie-zoom          zoom's scale                                           (1.08)
 *   --ie-duo-dark      duotone shadows                                        (#1e283c)
 *   --ie-duo-light     duotone highlights                                     (#9b85f0)
 *   --ie-tilt-max      tilt's largest lean, degrees                           (10)
 *   --ie-shine         shine's band of light                                  (rgb(255 255 255 / 0.45))
 *   --ie-caption-bg    caption panel                                          (rgb(20 24 40 / 0.86))
 *   --ie-caption-fg    caption text (keep 4.5:1 on the panel)                 (#fff)
 *   --ie-focus         focus ring                                             (#5933d8)
 *   --ie-tiles-height  the slideshow's height                                 (min(80vh, 44rem))
 *   --ie-scrim         tint under the slide's words                           (rgb(10 12 24 / 0.45))
 *   --ie-fg            the slide's words                                      (#fff)
 *   --ie-accent        the slide's button; --ie-on-accent its text            (#5933d8 / #fff)
 *   --ie-control-bg / --ie-control-fg   arrows and pause                      (rgb(0 0 0 / 0.45) / #fff)
 *   --ie-gallery-height  the strip's height                                   (clamp(16rem, 50vh, 36rem))
 *   --ie-gallery-width   one photo's width in the strip, of the strip's width (22cqi)
 *   --ie-gallery-gap     between photos in the strip                          (2cqi)
 */

// <image-effects-list>
const HOVER = ['pixelate', 'zoom', 'grayscale', 'duotone', 'tilt', 'shine', 'caption'] as const;
const EFFECTS = [...HOVER, 'tiles', 'gallery-open'] as const;
// </image-effects-list>
export type ImageEffect = (typeof EFFECTS)[number];
export interface Photo {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}
export interface Slide extends Photo {
  title?: string;
  text?: string;
  cta?: { text: string; href: string };
}

interface Props {
  effect: ImageEffect;
  /** Hover effects: the photo. `alt` is required ("" only when the photo is decorative). */
  src?: string;
  alt?: string;
  width?: number;
  height?: number;
  /** Hover effects: makes the frame a link, and the effect also shows on keyboard focus. */
  href?: string;
  /** Hover effects: a caption under the photo; with effect="caption", over it. */
  caption?: string;
  /** Hover effects: the frame's shape, e.g. "4 / 3". Default: width / height. */
  ratio?: string;
  loading?: 'lazy' | 'eager';
  /** tiles: two or more slides. */
  slides?: Slide[];
  /** tiles: ms per slide. */
  interval?: number;
  /** tiles: advance by itself (with a pause button). Off, it moves only with the arrows. */
  autoplay?: boolean;
  /** tiles: tiles per side. */
  grid?: number;
  /** tiles: whether the first slide flies in on load too (it starts invisible: an LCP cost). */
  intro?: boolean;
  /** tiles: the slideshow's name, for screen readers. */
  label?: string;
  /** tiles: level of the slide titles. */
  headingLevel?: 1 | 2 | 3;
  /** tiles: the button labels, for a non-English site. */
  labels?: { prev?: string; next?: string; pause?: string; play?: string; slide?: string };
  /** gallery-open: three or five photos; the middle one opens. */
  images?: Photo[];
  class?: string;
}

const {
  effect,
  src,
  alt,
  width,
  height,
  href,
  caption,
  ratio,
  loading = 'lazy',
  slides = [],
  interval = 10000,
  autoplay = true,
  grid = 7,
  intro = true,
  label = 'Slideshow',
  headingLevel = 2,
  labels = {},
  images = [],
  class: className,
} = Astro.props;

if (!EFFECTS.includes(effect)) throw new Error(`ImageEffects: effect "${effect}" is not one of ${EFFECTS.join(', ')}.`);
const hover = (HOVER as readonly string[]).includes(effect);
if (hover) {
  if (!src) throw new Error(`ImageEffects: effect="${effect}" needs \`src\`.`);
  if (typeof alt !== 'string') throw new Error(`ImageEffects: effect="${effect}" needs \`alt\`; write "" only if the photo is decorative.`);
  if (effect === 'caption' && !caption?.trim()) throw new Error('ImageEffects: effect="caption" needs `caption`.');
}
if (effect === 'tiles') {
  if (slides.length < 2) throw new Error('ImageEffects: effect="tiles" needs two or more `slides`.');
  for (const [i, s] of slides.entries()) {
    if (!s.src || typeof s.alt !== 'string') throw new Error(`ImageEffects: tiles slide ${i + 1} needs \`src\` and \`alt\`.`);
  }
  if (!Number.isInteger(grid) || grid < 2 || grid > 12) throw new Error('ImageEffects: `grid` is a whole number from 2 to 12.');
  if (interval < 5000) throw new Error('ImageEffects: `interval` is at least 5000 ms; a slide needs time to be read after its 3 s entrance.');
}
if (effect === 'gallery-open') {
  if (images.length !== 3 && images.length !== 5) throw new Error('ImageEffects: effect="gallery-open" needs three or five `images`; the middle one opens.');
  for (const [i, im] of images.entries()) {
    if (!im.src || typeof im.alt !== 'string') throw new Error(`ImageEffects: gallery-open image ${i + 1} needs \`src\` and \`alt\`.`);
  }
}

const words = {
  prev: labels.prev ?? 'Previous slide',
  next: labels.next ?? 'Next slide',
  pause: labels.pause ?? 'Pause slideshow',
  play: labels.play ?? 'Play slideshow',
  slide: labels.slide ?? '{n} of {total}',
};
const Heading = `h${headingLevel}`;
const frameRatio = ratio ?? (width && height ? `${width} / ${height}` : undefined);
const Frame = href ? 'a' : 'div';
// gallery-open: positions in the strip, outermost first; the centre is separate.
const centre = Math.floor(images.length / 2);
const sidePos = images.length === 5 ? ['l2', 'l1', '', 'r1', 'r2'] : ['l1', '', 'r1'];

// The stylesheet ships with the first instance on a page, the runtime with the first one that needs
// it (pixelate, tilt, tiles, gallery-open): a page of CSS-only effects ships no script at all.
const scripted = ['pixelate', 'tilt', 'tiles', 'gallery-open'].includes(effect);
const locals = Astro.locals as Record<string, unknown>;
const firstStyled = !locals.__imageEffectsStyle;
locals.__imageEffectsStyle = true;
const firstScripted = scripted && !locals.__imageEffectsRuntime;
if (scripted) locals.__imageEffectsRuntime = true;
---


{
  firstStyled && (
    <style is:inline data-ie-style>
      .ie {
        margin: 0;
      }
      .ie__frame {
        position: relative;
        display: block;
        overflow: hidden;
        isolation: isolate;
        border-radius: var(--ie-radius, 0);
        background: var(--ie-bg, #1e283c);
        color: inherit;
        outline-offset: 3px;
      }
      a.ie__frame:focus-visible {
        outline: 3px solid var(--ie-focus, #5933d8);
      }
      .ie__img {
        display: block;
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: cover;
      }
      .ie__caption {
        margin-top: 0.6rem;
        font-size: 0.95rem;
      }
      .ie__canvas,
      .ie__glare {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }

      /* grayscale and duotone: colour changes, not motion, so they change at once under reduced
         motion; the transition is the only thing reduced motion takes away. */
      .ie-grayscale .ie__img {
        filter: grayscale(1);
      }
      .ie-grayscale :is(.ie__frame:hover, a.ie__frame:focus-visible) .ie__img {
        filter: none;
      }
      .ie-duotone .ie__img {
        filter: grayscale(1) contrast(1.15);
      }
      .ie-duotone .ie__frame::before,
      .ie-duotone .ie__frame::after {
        content: '';
        position: absolute;
        inset: 0;
        /* Above the photo: its filter paints it in tree order with positioned boxes. */
        z-index: 1;
        pointer-events: none;
      }
      .ie-duotone .ie__frame::before {
        background: var(--ie-duo-light, #9b85f0);
        mix-blend-mode: multiply;
      }
      .ie-duotone .ie__frame::after {
        background: var(--ie-duo-dark, #1e283c);
        mix-blend-mode: lighten;
      }
      .ie-duotone :is(.ie__frame:hover, a.ie__frame:focus-visible) .ie__img {
        filter: none;
      }
      .ie-duotone :is(.ie__frame:hover, a.ie__frame:focus-visible)::before,
      .ie-duotone :is(.ie__frame:hover, a.ie__frame:focus-visible)::after {
        opacity: 0;
      }

      /* caption: over the photo, in from the bottom. Shown at rest where nothing can hover. */
      .ie-caption {
        position: relative;
        overflow: hidden;
        border-radius: var(--ie-radius, 0);
      }
      .ie-caption a.ie__frame:focus-visible {
        outline-offset: -3px;
      }
      .ie__overlay {
        pointer-events: none;
        position: absolute;
        inset: auto 0 0;
        padding: 0.9rem 1.1rem;
        background: var(--ie-caption-bg, rgb(20 24 40 / 0.86));
        color: var(--ie-caption-fg, #fff);
        font-size: 0.95rem;
        line-height: 1.4;
      }
      @media (hover: hover) {
        .ie-caption .ie__overlay {
          translate: 0 101%;
        }
        .ie-caption:is(:hover, :focus-within) .ie__overlay {
          translate: 0 0;
        }
      }

      .ie-tilt .ie__glare {
        background: linear-gradient(var(--ie-glare-angle, 180deg), rgb(255 255 255 / 0.5), rgb(255 255 255 / 0) 60%);
        opacity: 0;
        z-index: 1;
      }
      .ie-shine .ie__frame::after {
        content: '';
        position: absolute;
        inset: 0 auto 0 0;
        width: 45%;
        background: linear-gradient(100deg, transparent, var(--ie-shine, rgb(255 255 255 / 0.45)), transparent);
        translate: -120% 0;
        pointer-events: none;
        visibility: hidden;
      }

      @media (prefers-reduced-motion: no-preference) {
        .ie-grayscale .ie__img,
        .ie-duotone .ie__img,
        .ie-duotone .ie__frame::before,
        .ie-duotone .ie__frame::after {
          transition: filter var(--ie-duration, 0.6s) ease, opacity var(--ie-duration, 0.6s) ease;
        }
        .ie-zoom .ie__img {
          transition: scale calc(var(--ie-duration, 0.6s) * 2) cubic-bezier(0.2, 0.7, 0.2, 1);
        }
        .ie-zoom :is(.ie__frame:hover, a.ie__frame:focus-visible) .ie__img {
          scale: var(--ie-zoom, 1.08);
        }
        .ie-caption .ie__overlay {
          transition: translate calc(var(--ie-duration, 0.6s) * 0.6) cubic-bezier(0.2, 0.7, 0.2, 1);
        }
        .ie-tilt .ie__frame {
          transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
          will-change: transform;
        }
        .ie-tilt.is-tilting .ie__frame {
          transition-duration: 0.1s;
        }
        .ie-tilt a.ie__frame:focus-visible {
          transform: perspective(1000px) rotateX(4deg) scale(1.03);
        }
        .ie-tilt .ie__glare {
          transition: opacity 0.3s;
        }
        .ie-shine :is(.ie__frame:hover, a.ie__frame:focus-visible)::after {
          visibility: visible;
          translate: 330% 0;
          transition: translate calc(var(--ie-duration, 0.6s) * 1.5) ease-in-out;
        }
      }

      /* tiles */
      .ie-tiles {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        height: var(--ie-tiles-height, min(80vh, 44rem));
        background: var(--ie-bg, #1e283c);
        color: var(--ie-fg, #fff);
        border-radius: var(--ie-radius, 0);
      }
      .ie-tiles__slide {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        visibility: hidden;
      }
      .ie-tiles__slide.is-current {
        visibility: visible;
        z-index: 2;
      }
      .ie-tiles__slide.is-leaving {
        visibility: visible;
        z-index: 1;
      }
      .ie-tiles__img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: cover;
      }
      .ie-tiles__slide.is-entering .ie-tiles__img {
        opacity: 0;
      }
      .ie-tiles__grid {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .ie-tiles__tile {
        position: absolute;
        background-repeat: no-repeat;
      }
      @media (prefers-reduced-motion: no-preference) {
        .ie-tiles__tile {
          will-change: transform, opacity;
        }
      }
      .ie-tiles__layers {
        position: relative;
        z-index: 1;
        display: grid;
        justify-items: center;
        gap: 1rem;
        max-width: min(60rem, 100% - 7rem);
        padding: 1.5rem;
        text-align: center;
        background: radial-gradient(closest-side, var(--ie-scrim, rgb(10 12 24 / 0.45)), transparent);
      }
      .ie-tiles__title {
        margin: 0;
        font-size: clamp(1.6rem, 4.2vw, 3.3rem);
        line-height: 1.12;
        letter-spacing: -0.02em;
        color: inherit;
        text-shadow: 0 2px 18px rgb(0 0 0 / 0.45);
      }
      .ie-tiles__text {
        margin: 0;
        font-size: clamp(1.05rem, 2vw, 1.5rem);
        text-shadow: 0 1px 12px rgb(0 0 0 / 0.5);
      }
      .ie-tiles__cta {
        display: inline-block;
        padding: 0.75rem 2rem;
        border-radius: 9px;
        background: var(--ie-accent, #5933d8);
        color: var(--ie-on-accent, #fff);
        font-weight: 600;
        text-decoration: none;
        outline-offset: 3px;
      }
      .ie-tiles__cta:focus-visible,
      .ie-tiles__btn:focus-visible {
        outline: 3px solid var(--ie-on-accent, #fff);
      }
      .ie-tiles__controls {
        position: absolute;
        z-index: 3;
        right: 1rem;
        bottom: 1rem;
        display: flex;
        gap: 0.5rem;
      }
      .ie-tiles__controls[hidden],
      .ie-tiles__btn[hidden] {
        display: none;
      }
      .ie-tiles__btn {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border: 1px solid rgb(255 255 255 / 0.55);
        border-radius: 50%;
        background: var(--ie-control-bg, rgb(0 0 0 / 0.45));
        color: var(--ie-control-fg, #fff);
        cursor: pointer;
      }
      .ie-tiles__play,
      .ie-tiles.is-paused .ie-tiles__pause {
        display: none;
      }
      .ie-tiles.is-paused .ie-tiles__play {
        display: block;
      }
      /* Without the script, only the first slide is shown. */
      .ie-tiles:not(.ie-tiles--live) .ie-tiles__slide:first-child {
        visibility: visible;
      }

      /* gallery-open: the strip is the rest state (no script, reduced motion). */
      .ie-gallery {
        container-type: inline-size;
        overflow: clip;
      }
      .ie-gallery__stage {
        --p1: 0;
        --p2: 1;
        --w: var(--ie-gallery-width, 22cqi);
        --g: var(--ie-gallery-gap, 2cqi);
        --h: 77%;
        position: relative;
        height: var(--ie-gallery-height, clamp(16rem, 50vh, 36rem));
      }
      .ie-gallery__centre,
      .ie-gallery__side {
        position: absolute;
        overflow: hidden;
        border-radius: var(--ie-radius, 0);
        background: var(--ie-bg, #1e283c);
      }
      .ie-gallery__centre {
        inset: 0;
        border-radius: 0;
        clip-path: inset(
          calc((100% - var(--h)) * var(--p2)) calc((50cqi - var(--w) / 2) * var(--p2)) 0
            calc((50cqi - var(--w) / 2) * var(--p2)) round calc(var(--ie-radius, 0px) * var(--p2))
        );
      }
      .ie-gallery__side {
        top: 0;
        width: var(--w);
        height: var(--h);
      }
      .ie-gallery__l1,
      .ie-gallery__r1 {
        top: calc((100% - var(--h)) / 2);
      }
      .ie-gallery__l2 {
        left: calc(50cqi - var(--w) * 2.5 - var(--g) * 2);
      }
      .ie-gallery__l1 {
        left: calc(50cqi - var(--w) * 1.5 - var(--g));
      }
      .ie-gallery__r1 {
        left: calc(50cqi + var(--w) * 0.5 + var(--g));
      }
      .ie-gallery__r2 {
        left: calc(50cqi + var(--w) * 1.5 + var(--g) * 2);
      }
      .ie-gallery__l1,
      .ie-gallery__l2 {
        translate: calc((50cqi - var(--w) / 2) * var(--p1) * -1) 0;
      }
      .ie-gallery__r1,
      .ie-gallery__r2 {
        translate: calc((50cqi - var(--w) / 2) * var(--p1)) 0;
      }

      @media (forced-colors: active) {
        .ie-duotone .ie__frame::before,
        .ie-duotone .ie__frame::after {
          display: none;
        }
      }
    </style>
  )
}
{
  firstScripted && (
    <script is:inline>
      (() => {
        if (window.__imageEffects) return;
        const still = matchMedia('(prefers-reduced-motion: reduce)');
        const rand = (a, b) => a + Math.random() * (b - a);
        const finePointer = (e) => e.pointerType === 'mouse' || e.pointerType === 'pen';
        const focusVisible = (el) => { try { return el.matches(':focus-visible'); } catch { return true; } };

        // The rectangle object-fit: cover draws a w×h picture into a box, as [x, y, w, h].
        const cover = (box, w, h) => {
          const r = w / h;
          if (r < box.w / box.h) return [0, (box.h - box.w / r) / 2, box.w, box.w / r];
          return [(box.w - box.h * r) / 2, 0, box.h * r, box.h];
        };

        // <ie-pixelate> The Aine theme's gallery hover, step for step.
        const STEPS = [40, 10, 4, 10, 40];
        const pixelate = (fig) => {
          const frame = fig.querySelector('.ie__frame');
          const img = fig.querySelector('.ie__img');
          let busy = false;
          const run = () => {
            if (busy || still.matches || !img.complete || !img.naturalWidth) return;
            const box = { w: Math.round(img.clientWidth), h: Math.round(img.clientHeight) };
            if (!box.w || !box.h) return;
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            if (!ctx) return;
            busy = true;
            canvas.className = 'ie__canvas';
            canvas.setAttribute('aria-hidden', 'true');
            canvas.width = box.w;
            canvas.height = box.h;
            const [dx, dy, dw, dh] = cover(box, img.naturalWidth, img.naturalHeight);
            ctx.imageSmoothingEnabled = false;
            ctx.drawImage(img, dx, dy, dw, dh);
            frame.appendChild(canvas);
            STEPS.forEach((pct, i) => {
              const w = (box.w * pct) / 100;
              const h = (box.h * pct) / 100;
              setTimeout(() => {
                ctx.drawImage(img, dx, dy, dw, dh);
                ctx.drawImage(canvas, 0, 0, w, h);
                ctx.drawImage(canvas, 0, 0, w - 0.5, h - 0.5, 0, 0, box.w, box.h);
              }, 100 * i);
            });
            setTimeout(() => { canvas.remove(); busy = false; }, 500);
          };
          frame.addEventListener('pointerenter', (e) => { if (finePointer(e)) run(); });
          frame.addEventListener('focus', () => { if (focusVisible(frame)) run(); });
        };
        // </ie-pixelate>

        // <ie-tilt> After vanilla-tilt.js (MIT): lean toward the pointer, glare from the far edge.
        const tilt = (fig) => {
          const frame = fig.querySelector('.ie__frame');
          const glare = document.createElement('span');
          glare.className = 'ie__glare';
          glare.setAttribute('aria-hidden', 'true');
          frame.appendChild(glare);
          let raf = 0;
          let px = 0.5;
          let py = 0.5;
          const draw = () => {
            raf = 0;
            const max = parseFloat(getComputedStyle(fig).getPropertyValue('--ie-tilt-max')) || 10;
            const rx = (0.5 - py) * 2 * max;
            const ry = (px - 0.5) * 2 * max;
            frame.style.transform = `perspective(1000px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) scale(1.03)`;
            const angle = (Math.atan2(px - 0.5, -(py - 0.5)) * 180) / Math.PI;
            glare.style.setProperty('--ie-glare-angle', `${angle.toFixed(1)}deg`);
            glare.style.opacity = (Math.hypot(px - 0.5, py - 0.5) * 0.9).toFixed(2);
          };
          frame.addEventListener('pointermove', (e) => {
            if (!finePointer(e) || still.matches) return;
            const r = frame.getBoundingClientRect();
            px = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
            py = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
            fig.classList.add('is-tilting');
            if (!raf) raf = requestAnimationFrame(draw);
          });
          frame.addEventListener('pointerleave', () => {
            if (raf) cancelAnimationFrame(raf);
            raf = 0;
            fig.classList.remove('is-tilting');
            frame.style.transform = '';
            glare.style.opacity = '';
          });
        };
        // </ie-tilt>

        // <ie-tiles> Slider Revolution's slide-based tile transition, on the Web Animations API.
        const tiles = (root) => {
          const slides = [...root.querySelectorAll('[data-ie-slide]')];
          const controls = root.querySelector('[data-ie-controls]');
          const toggle = root.querySelector('[data-ie-toggle]');
          const n = Number(root.dataset.grid) || 7;
          const interval = Number(root.dataset.interval) || 10000;
          const auto = root.dataset.autoplay === '1';
          const OUT = 'cubic-bezier(0.215, 0.61, 0.355, 1)'; // power3.out
          const IN_OUT = 'cubic-bezier(0.77, 0, 0.175, 1)'; // power4.inOut
          let current = 0;
          let timer = 0;
          let paused = false; // the visitor pressed Pause
          let held = false; // hover or focus inside
          let visible = true;
          root.classList.add('ie-tiles--live');
          controls.hidden = false;

          const layers = (s) => [...s.querySelectorAll('[data-ie-layer]')];
          const settle = (s) => {
            s.querySelectorAll('.ie-tiles__grid').forEach((g) => g.remove());
            s.classList.remove('is-entering');
            layers(s).forEach((l) => l.getAnimations().forEach((a) => a.cancel()));
          };
          const enter = (s) => {
            settle(s);
            if (still.matches) return;
            const img = s.querySelector('.ie-tiles__img');
            s.classList.add('is-entering');
            const start = () => {
              if (!s.classList.contains('is-entering')) return;
              const box = { w: s.clientWidth, h: s.clientHeight };
              const nat = { w: img.naturalWidth || box.w, h: img.naturalHeight || box.h };
              const [ox, oy, cw, ch] = cover(box, nat.w, nat.h);
              const grid = document.createElement('div');
              grid.className = 'ie-tiles__grid';
              grid.setAttribute('aria-hidden', 'true');
              const url = `url("${(img.currentSrc || img.src).replace(/"/g, '%22')}")`;
              const tw = box.w / n;
              const th = box.h / n;
              const runs = [];
              for (let r = 0; r < n; r++) {
                for (let c = 0; c < n; c++) {
                  const t = document.createElement('span');
                  t.className = 'ie-tiles__tile';
                  t.style.cssText = `left:${c * tw}px;top:${r * th}px;width:${tw + 1}px;height:${th + 1}px;` +
                    `background-image:${url};background-size:${cw}px ${ch}px;background-position:${ox - c * tw}px ${oy - r * th}px`;
                  grid.appendChild(t);
                  runs.push(t.animate(
                    [
                      { opacity: 0, transform: `translate(${rand(-100, 100).toFixed(0)}px, 100%) rotate(${rand(-100, 100).toFixed(0)}deg) scale(${rand(0, 2).toFixed(2)})` },
                      { opacity: 1, transform: 'none' },
                    ],
                    { duration: 1000, delay: (r * n + c) * 45, easing: OUT, fill: 'backwards' },
                  ));
                }
              }
              s.appendChild(grid);
              Promise.all(runs.map((a) => a.finished)).then(() => {
                if (s.contains(grid)) { grid.remove(); s.classList.remove('is-entering'); }
              }, () => {});
            };
            img.complete ? start() : img.decode().then(start, () => s.classList.remove('is-entering'));
            const [title, text, cta] = ['title', 'text', 'cta'].map((k) => s.querySelector(`[data-ie-layer="${k}"]`));
            title?.animate([{ opacity: 0, transform: 'translateX(-100%) skewX(45deg)' }, { opacity: 1, transform: 'none' }], { duration: 1000, delay: 300, easing: IN_OUT, fill: 'backwards' });
            text?.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 1000, delay: 500, fill: 'backwards' });
            cta?.animate([{ opacity: 0, transform: 'translateY(50px)' }, { opacity: 1, transform: 'none' }], { duration: 1000, delay: 600, easing: IN_OUT, fill: 'backwards' });
          };
          const mark = () => slides.forEach((s, i) => {
            const on = i === current;
            s.classList.toggle('is-current', on);
            s.inert = !on;
            on ? s.removeAttribute('aria-hidden') : s.setAttribute('aria-hidden', 'true');
          });
          const go = (next) => {
            next = (next + slides.length) % slides.length;
            if (next === current) return;
            const leaving = slides[current];
            settle(leaving);
            leaving.classList.add('is-leaving');
            if (!still.matches) layers(leaving).forEach((l) => l.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 600, fill: 'forwards' }));
            current = next;
            mark();
            enter(slides[current]);
            // The leaving slide stays under the tiles until they have landed.
            const done = still.matches ? 0 : 1000 + (n * n - 1) * 45;
            setTimeout(() => {
              if (slides[current] !== leaving) { leaving.classList.remove('is-leaving'); settle(leaving); }
            }, done);
            schedule();
          };
          const runs = () => auto && !still.matches && !paused && !held && visible && !document.hidden;
          const schedule = () => {
            clearTimeout(timer);
            if (runs()) timer = setTimeout(() => go(current + 1), interval);
          };
          const sync = () => {
            toggle.hidden = !auto || still.matches;
            root.classList.toggle('is-paused', paused);
            toggle.setAttribute('aria-label', paused ? root.dataset.play : root.dataset.pause);
            schedule();
          };
          root.querySelector('[data-ie-prev]').addEventListener('click', () => go(current - 1));
          root.querySelector('[data-ie-next]').addEventListener('click', () => go(current + 1));
          toggle.addEventListener('click', () => { paused = !paused; held = false; sync(); });
          root.addEventListener('pointerenter', (e) => { if (finePointer(e)) { held = true; schedule(); } });
          root.addEventListener('pointerleave', () => { held = root.contains(document.activeElement) && focusVisible(document.activeElement); schedule(); });
          root.addEventListener('focusin', (e) => { if (e.target !== toggle && focusVisible(e.target)) { held = true; schedule(); } });
          root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget)) { held = false; schedule(); } });
          document.addEventListener('visibilitychange', schedule);
          new IntersectionObserver(([e]) => { visible = e.isIntersecting; schedule(); }).observe(root);
          still.addEventListener('change', () => { if (still.matches) slides.forEach(settle); sync(); });
          mark();
          if (root.dataset.intro === '1') enter(slides[0]);
          sync();
        };
        // </ie-tiles>

        // <ie-gallery> The Aine theme's image gallery hero: --p1 opens, --p2 = 1 - --p1.
        const gallery = (root) => {
          const stage = root.querySelector('[data-ie-stage]');
          let raf = 0;
          let visible = false;
          const frame = () => {
            raf = 0;
            const vh = window.innerHeight;
            const p1 = still.matches ? 0 : Math.min(1, Math.max(0, (vh / 2 - stage.getBoundingClientRect().top) / (vh / 2)));
            stage.style.setProperty('--p1', p1.toFixed(3));
            stage.style.setProperty('--p2', (1 - p1).toFixed(3));
          };
          const request = () => { if (!raf && visible) raf = requestAnimationFrame(frame); };
          new IntersectionObserver(([e]) => { visible = e.isIntersecting; request(); }).observe(root);
          addEventListener('scroll', request, { passive: true });
          addEventListener('resize', request);
          still.addEventListener('change', frame);
          frame();
        };
        // </ie-gallery>

        const mounts = { pixelate, tilt, tiles, 'gallery-open': gallery };
        const mount = (el) => {
          if (!el || !el.dataset || el.dataset.ieReady || !mounts[el.dataset.ie]) return;
          el.dataset.ieReady = '1';
          mounts[el.dataset.ie](el);
        };
        window.__imageEffects = { mount, boot: () => document.querySelectorAll('[data-ie]').forEach(mount) };
      })();
    </script>
  )
}

{
  hover && (
    <figure class:list={['ie', `ie-${effect}`, className]} data-ie={effect}>
      <Frame class="ie__frame" href={href} style={frameRatio ? `aspect-ratio:${frameRatio}` : undefined}>
        <img class="ie__img" src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" />
      </Frame>
      {caption && <figcaption class={effect === 'caption' ? 'ie__overlay' : 'ie__caption'}>{caption}</figcaption>}
    </figure>
  )
}
{
  effect === 'tiles' && (
    <section
      class:list={['ie', 'ie-tiles', className]}
      data-ie="tiles"
      data-interval={interval}
      data-autoplay={autoplay ? '1' : '0'}
      data-grid={grid}
      data-intro={intro ? '1' : '0'}
      data-pause={words.pause}
      data-play={words.play}
      aria-roledescription="carousel"
      aria-label={label}
    >
      {slides.map((s, i) => (
        <div
          class:list={['ie-tiles__slide', { 'is-current': i === 0 }]}
          role="group"
          aria-roledescription="slide"
          aria-label={words.slide.replace('{n}', String(i + 1)).replace('{total}', String(slides.length))}
          data-ie-slide
        >
          <img
            class="ie-tiles__img"
            src={s.src}
            alt={s.alt}
            width={s.width}
            height={s.height}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          {(s.title || s.text || s.cta) && (
            <div class="ie-tiles__layers">
              {s.title && <Heading class="ie-tiles__title" data-ie-layer="title">{s.title}</Heading>}
              {s.text && <p class="ie-tiles__text" data-ie-layer="text">{s.text}</p>}
              {s.cta && (
                <a class="ie-tiles__cta" href={s.cta.href} data-ie-layer="cta">
                  {s.cta.text}
                </a>
              )}
            </div>
          )}
        </div>
      ))}
      <div class="ie-tiles__controls" hidden data-ie-controls>
        <button class="ie-tiles__btn" type="button" aria-label={words.prev} data-ie-prev>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z" /></svg>
        </button>
        <button class="ie-tiles__btn" type="button" aria-label={words.pause} data-ie-toggle>
          <svg class="ie-tiles__pause" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6 5h4v14H6zm8 0h4v14h-4z" /></svg>
          <svg class="ie-tiles__play" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 5v14l11-7z" /></svg>
        </button>
        <button class="ie-tiles__btn" type="button" aria-label={words.next} data-ie-next>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12z" /></svg>
        </button>
      </div>
    </section>
  )
}
{
  effect === 'gallery-open' && (
    <div class:list={['ie', 'ie-gallery', className]} data-ie="gallery-open">
      <div class="ie-gallery__stage" data-ie-stage>
        {images.map((im, i) =>
          i === centre ? null : (
            <div class={`ie-gallery__side ie-gallery__${sidePos[i]}`}>
              <img class="ie__img" src={im.src} alt={im.alt} width={im.width} height={im.height} loading={loading} decoding="async" />
            </div>
          ),
        )}
        <div class="ie-gallery__centre">
          <img class="ie__img" src={images[centre]?.src} alt={images[centre]?.alt} width={images[centre]?.width} height={images[centre]?.height} loading={loading} decoding="async" />
        </div>
      </div>
    </div>
  )
}
{scripted && (
  <script is:inline>window.__imageEffects.mount(document.currentScript.previousElementSibling);</script>
)}
